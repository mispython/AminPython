/* WOF - Input dataset field definitions */

libname pibb "/exdwh/host/ln/npl_hp_sasdata/pibb"
    access=readonly;

libname pbb "/exdwh/host/ln/npl_hp_sasdata/pbb"
    access=readonly;

libname enrich "/sas/ln/dwh/enrichment"
    access=readonly;

libname lnbase "/dwh/ln_ln"
    access=readonly;

libname control "/sasdata/dwh/control"
    access=readonly;


/* Display metadata; skip missing datasets */
%macro contents(dataset);
    %if %sysfunc(exist(&dataset)) %then %do;
        title "Input: &dataset";
        proc contents data=&dataset varnum;
        run;
    %end;
    %else %do;
        %put WARNING: Input dataset &dataset does not exist.;
    %end;
%mend;


