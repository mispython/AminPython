#!/usr/bin/env python3
"""TEST - Convert LNNOTE SAS7BDAT to Parquet."""

from pathlib import Path
from time import perf_counter

from pandas.io.sas.sas7bdat import SAS7BDATReader
import pyarrow as pa
import pyarrow.parquet as pq


INPUT_FILE = Path(
    "/sas/ln/dwh/enrichment/enrh_ln_note_d26.sas7bdat"
)
OUTPUT_FILE = Path(
    "/stgsrcsys/host/holding/pas/enrh_ln_note_d26.parquet"
)

CHUNK_ROWS = 50_000
ENCODING = "latin-1"


def text(value):
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode(ENCODING)
    return str(value)


def main():
    started = perf_counter()
    OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)
    temporary = OUTPUT_FILE.with_suffix(".parquet.tmp")
    total = 0

    try:
        with SAS7BDATReader(
            INPUT_FILE,
            encoding=ENCODING,
            convert_dates=False,
        ) as reader:
            expected = reader.row_count

            # Preserve SAS field definitions as Parquet metadata.
            schema = pa.schema([
                pa.field(
                    text(column.name),
                    pa.string()
                    if column.ctype == b"s"
                    else pa.float64(),
                    metadata={
                        "sas_type": (
                            "Character"
                            if column.ctype == b"s"
                            else "Numeric"
                        ),
                        "sas_length": str(column.length),
                        "sas_format": text(column.format),
                        "sas_label": text(column.label),
                    },
                )
                for column in reader.columns
            ])

            with pq.ParquetWriter(
                temporary,
                schema,
                compression="snappy",
            ) as writer:
                while True:
                    chunk = reader.read(CHUNK_ROWS)

                    if chunk is None or chunk.empty:
                        break

                    table = pa.Table.from_pandas(
                        chunk,
                        schema=schema,
                        preserve_index=False,
                    )
                    writer.write_table(table)
                    total += len(chunk)

                    print(
                        f"Converted: {total:,} / {expected:,}",
                        flush=True,
                    )

                    del table, chunk

        actual = pq.ParquetFile(temporary).metadata.num_rows

        if total != expected or actual != expected:
            raise RuntimeError(
                f"Count mismatch: SAS={expected}, "
                f"read={total}, Parquet={actual}"
            )

        temporary.replace(OUTPUT_FILE)

        print(f"Output: {OUTPUT_FILE}")
        print(f"Records: {total:,}")
        print(f"Elapsed: {perf_counter() - started:.1f} seconds")

    finally:
        temporary.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
