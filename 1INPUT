libname fccmart '/stgsrcsys/host/uat';

%macro load_cir_close(input_ds=);

    %local min_year max_year load_year
           row_count step_rc;

    /*==========================================================
      1. Prepare historical records: Jan 2024 through today

      APPR_DATE is CHARACTER length 26:
      YYYY-MM-DD-HH.MM.SS.ffffff
    ==========================================================*/

    data work._cir_close_ready(drop=_appr_day)
         work._cir_close_invalid_date(drop=_appr_day);

        set &input_ds;

        /* Read the date portion; retain original APPR_DATE */
        _appr_day = input(substr(APPR_DATE,1,10), ?? yymmdd10.);

        if missing(_appr_day) then
            output work._cir_close_invalid_date;

        else if _appr_day >= '01JAN2024'd
            and _appr_day <= today() then
            output work._cir_close_ready;
    run;

    %let step_rc = &syserr;

    %if &step_rc > 4 %then %do;
        %put ERROR: Failed to prepare CIR_CLOSE records.;
        %let syscc = 8;
        %return;
    %end;

    /*==========================================================
      2. Get earliest and latest approval years in this batch
    ==========================================================*/

    proc sql noprint;
        select count(*),
               min(input(substr(APPR_DATE,1,4),4.)),
               max(input(substr(APPR_DATE,1,4),4.))
          into :row_count trimmed,
               :min_year trimmed,
               :max_year trimmed
        from work._cir_close_ready;
    quit;

    %if &sqlrc ne 0 %then %do;
        %put ERROR: Failed to determine approval years.;
        %let syscc = 8;
        %return;
    %end;

    %if &row_count = 0 %then %do;
        %put NOTE: No eligible records to load.;
        %return;
    %end;

    /*==========================================================
      3. Separate records by APPR_DATE year
    ==========================================================*/

    %do load_year = &min_year %to &max_year;

        data work._cir_close_year;
            set work._cir_close_ready;

            where substr(APPR_DATE,1,4) = "&load_year";
        run;

        %let step_rc = &syserr;

        %if &step_rc > 4 %then %do;
            %put ERROR: Failed to prepare year &load_year.;
            %let syscc = 8;
            %return;
        %end;

        proc sql noprint;
            select count(*)
              into :row_count trimmed
            from work._cir_close_year;
        quit;

        %if &sqlrc ne 0 %then %do;
            %put ERROR: Failed to count records for &load_year.;
            %let syscc = 8;
            %return;
        %end;

        /*======================================================
          4. Create target if absent; otherwise append
        ======================================================*/

        %if &row_count > 0 %then %do;

            %if %sysfunc(
                exist(fccmart.CIR_CLOSE_&load_year)
            ) %then %do;

                proc append
                    base=fccmart.CIR_CLOSE_&load_year
                    data=work._cir_close_year;
                run;

            %end;
            %else %do;

                data fccmart.CIR_CLOSE_&load_year;
                    set work._cir_close_year;
                run;

            %end;

            %let step_rc = &syserr;

            %if &step_rc ne 0 %then %do;
                %put ERROR: Load returned code &step_rc for CIR_CLOSE_&load_year..;
                %put ERROR: Review the SAS log before rerunning.;
                %let syscc = 8;
                %return;
            %end;

            %put NOTE: Loaded &row_count records into FCCMART.CIR_CLOSE_&load_year..;

        %end;

    %end;

%mend load_cir_close;


/* Run using the SAS DI User Written input */
%load_cir_close(input_ds=&_INPUT);

/* Existing SAS DI return-code macro */
%rcSet(&syscc);
