#!/usr/bin/env python3
"""TEST - Convert NPLOBAL, WIIS, WAQ and WSP2 to Parquet."""
from pathlib import Path
from time import perf_counter
from pandas.io.sas.sas7bdat import SAS7BDATReader
import pyarrow as pa
import pyarrow.parquet as pq

INPUT_FOLDER = Path("/exdwh/host/ln/npl_hp_sasdata/pibb/woff")
OUTPUT_FOLDER = Path("/stgsrcsys/host/holding/pas")
DATASETS = ("nplobal", "wiis", "waq", "wsp2")
CHUNK_ROWS = 50_000
ENCODING = "latin-1"


def text(value):
    if value is None:
        return ""
    return value.decode(ENCODING) if isinstance(value, bytes) else str(value)


def convert(source, destination):
    started = perf_counter()
    temporary = destination.with_suffix(".parquet.tmp")
    count = 0
    try:
        with SAS7BDATReader(source, encoding=ENCODING, convert_dates=False) as reader:
            expected = reader.row_count
            schema = pa.schema([
                pa.field(text(col.name), pa.string() if col.ctype == b"s" else pa.float64(),
                         metadata={"sas_type": "Character" if col.ctype == b"s" else "Numeric",
                                   "sas_length": str(col.length),
                                   "sas_format": text(col.format),
                                   "sas_label": text(col.label)})
                for col in reader.columns
            ])
            with pq.ParquetWriter(temporary, schema, compression="snappy") as writer:
                while True:
                    frame = reader.read(CHUNK_ROWS)
                    if frame is None or frame.empty:
                        break
                    table = pa.Table.from_pandas(frame, schema=schema, preserve_index=False)
                    writer.write_table(table)
                    count += len(frame)
                    print(f"{source.name}: {count:,} / {expected:,}", flush=True)
                    del table, frame
        actual = pq.ParquetFile(temporary).metadata.num_rows
        if count != expected or actual != expected:
            raise RuntimeError(f"{source.name}: record count mismatch")
        temporary.replace(destination)
        print(f"Completed: {destination} ({perf_counter() - started:.1f} seconds)", flush=True)
    finally:
        temporary.unlink(missing_ok=True)


def main():
    # Check all inputs before starting conversion.
    for name in DATASETS:
        source = INPUT_FOLDER / (name + ".sas7bdat")
        if not source.is_file():
            raise FileNotFoundError(source)
    OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)
    for name in DATASETS:
        convert(INPUT_FOLDER / (name + ".sas7bdat"),
                OUTPUT_FOLDER / (name + ".parquet"))


if __name__ == "__main__":
    main()




