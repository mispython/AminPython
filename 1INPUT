//*
//DELETE   EXEC PGM=IEFBR14
//DD1      DD DSN=SAP.PBB.XCRR.SASDATA,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,1,RLSE)
//DD2      DD DSN=SAP.PBB.XCRR.TEXT,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,1,RLSE)
//*
//EIBXCRRA EXEC SAS609
//BNM      DD DSN=SAP.PBB.MNILN(0),DISP=SHR
//PGM      DD DSN=SAP.BNM.PROGRAM,DISP=SHR
//LIMIT    DD DSN=SAP.PBB.MNILIMT(0),DISP=SHR
//SASD     DD DSN=SAP.PBB.SASDATA,DISP=SHR
//DEPOSIT  DD DSN=SAP.PBB.MNITB(0),DISP=SHR
//E1271    DD DSN=SAP.PBB.XCRR.SASDATA,
//            DISP=(NEW,CATLG,DELETE),
//            DCB=(RECFM=FS,LRECL=27648,BLKSIZE=27648),
//            SPACE=(CYL,(60,30),RLSE),UNIT=SYSDA
//CRR      DD DSN=SAP.PBB.XCRR.TEXT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,50),RLSE),UNIT=SYSDA,
//            DCB=(LRECL=80,RECFM=FB,BLKSIZE=0,BUFNO=30)
//SASLIST  DD SYSOUT=A
//SYSIN    DD *

OPTIONS YEARCUTOFF=1950 NONUMBER NODATE NOCENTER MISSING=0;
*;
%INC PGM(PBBLNFMT,PBBDPFMT,PBMISFMT);
*;
DATA DATES;
   SET BNM.REPTDATE;
   SELECT(DAY(REPTDATE));
   WHEN (8)  DO; SDD = 1;  WK = '1'; WK1 = '4'; END;
   WHEN(15)  DO; SDD = 9;  WK = '2'; WK1 = '1'; END;
   WHEN(22)  DO; SDD = 16; WK = '3'; WK1 = '2'; END;
     OTHERWISE DO; SDD = 23; WK = '4'; WK1 = '3'; END;
   END;
   MM = MONTH(REPTDATE);
   IF WK = '1' THEN DO;
      MM1 = MM - 1;
      IF MM1 = 0 THEN MM1 = 12;
   END;
   ELSE MM1 = MM;
   IF WK = '4' THEN MM2 = MM;
   ELSE DO MM2 = MM - 1 ;
      IF MM2 = 0 THEN MM2 = 12;
   END;
   DAYS = DAY(REPTDATE);
   MONTHS = MONTH(REPTDATE);
   YEARS = YEAR(REPTDATE);
   SDATE = MDY(MONTHS,DAYS,YEARS);
   CALL SYMPUT('NOWK',PUT(WK,$1.));
   CALL SYMPUT('REPTMON',PUT(MM,Z2.));
   CALL SYMPUT('REPTYEAR',PUT(REPTDATE,YEAR4.));
   CALL SYMPUT('RDATE',PUT(REPTDATE,DDMMYY8.));
   CALL SYMPUT('REPTDAY',PUT(DAY(REPTDATE),Z2.));
   CALL SYMPUT('SDATE',PUT(SDATE,Z5.));
RUN;
*;
PROC PRINT DATA=DATES;
*;
DATA CA;
   KEEP USER3 RISKCODE ORGCODE DAYSARR BRANCH ORGTYPE
        ACCTNO NAME PRODUCT BALANCE FAACRR CRRCODE;
   SET  DEPOSIT.CURRENT;
   IF   CURBAL < 0;
   BALANCE=ABS(CURBAL);
   DAYSARR=0;
PROC SORT; BY ACCTNO;
*;
DATA LIMIT;
   KEEP ACCTNO LMTAMT APPRLIMT EXCESSDT;
   SET  LIMIT.OVERDFT;
PROC SORT; BY ACCTNO;
*;
DATA OD;
   MERGE CA(IN=A) LIMIT; BY ACCTNO;
   IF A;
   IF APPRLIMT > 0 AND LMTAMT > 0 AND USER3 NE '5' AND
      RISKCODE NOT IN ('1','2','3','4')            AND
      ORGCODE  NOT IN ('001','1')                  AND
      PRODUCT  NOT IN (103,104,105,106,107,116,119,120,126,127,
                       128,129,137,138,140,141,142,144,145,146,
                       147,148,149,151,154,155,158,164,171,
                       172,173,177,178,180,181,182,191,192,
                       193,194,195,549,550);
   CATG='OD';
   GRADE=FAACRR;
   IF  SUBSTR(CRRCODE,1,1) IN ('A','B','C','D','E')
       THEN GRADE=CRRCODE;
   GRADEX=SUBSTR(GRADE,1,1);
*;
DATA NOTE;
   KEEP BRANCH BLDATE SCORE1 SCORE2 GRADE GRADEX
        ACCTNO NOTENO NAME PRODUCT;
   SET BNM.LNNOTE;
   IF  NOTENO > 0 AND CORPCODE NE 'C' AND ORGTYPE NE 'E' AND
       BALANCE > 1.00;
   BRANCH =PENDBRH;
   PRODUCT=LOANTYPE;
   GRADE=SCORE2;
   IF  SUBSTR(SCORE1,1,1) IN ('A','B','C','D','E')
       THEN GRADE=SCORE1;
   GRADEX=SUBSTR(GRADE,1,1);
*;
PROC SORT; BY ACCTNO NOTENO;
*;
DATA LOAN;
   KEEP ACCTNO NOTENO APPRLIMT BALANCE RISKRTE;
   SET SASD.LOAN&REPTMON&NOWK;
   IF  NOTENO > 0 AND BALANCE > 1.00;
PROC SORT; BY ACCTNO NOTENO;
*;
DATA LOAN1;
   DROP NAME BRANCH PRODUCT;
   SET  SASD.LOAN&REPTMON&NOWK;
   IF   ACCTYPE='OD';
PROC SORT; BY ACCTNO;
*;
DATA ODHL;
   KEEP ACCTNO NOTENO APPRLIMT BALANCE RISKRTE CATG
        USER3 RISKCODE ORGCODE DAYSARR GRADE BRANCH
        GRADEX
        ACCTNO NAME PRODUCT BALANCE FAACRR CRRCODE;
  MERGE CA LOAN1(IN=A); BY ACCTNO;
  IF A;
  IF RISKRTE  NOT IN (1,2,3,4)   AND
     ORGCODE  NE 'C'             AND
     ORGTYPE  NE 'E'             AND
     PRODUCT  IN (103,116,119,120,137,138,154,155,192,
                  193,194,195);
  CATG='OL';
  GRADE=FAACRR;
  IF  SUBSTR(CRRCODE,1,1) IN ('A','B','C','D','E')
      THEN GRADE=CRRCODE;
  GRADEX=SUBSTR(GRADE,1,1);
*;
DATA HL FL;
   MERGE NOTE(IN=A) LOAN; BY ACCTNO NOTENO;
   IF A;
   IF RISKRTE NOT IN (1,2,3,4);
   DAYSARR=0;
   IF BLDATE  GT 0     THEN DAYSARR=&SDATE-BLDATE;
   IF DAYSARR LT 0     THEN DAYSARR=0;
   IF PRODUCT IN (300,301,302,304,305,309,310,320,325,335,350,
                  355,356,357,358,359,360,361,500,504,505,506,
                  509,510,515,520,521,522,526,528,529,
                  524,525,527,530,531,556,
                  559,560,564,565,566,567,568,569,570,573)
   THEN DO;
      CATG='FL';
      OUTPUT FL;
   END;
   IF PRODUCT IN (110,111,112,113,114,115,116,117,118,118,120,
                  139,140,141,142,143,225,226,244,245,246,247,
                  200,201,204,205,209,210,211,212,214,215,
                  219,220,227,228,230,231,232,233,234,235,236,
                  237,238,239,240,241,242,243)
   THEN DO;
      CATG='HL';
      OUTPUT HL;
   END;
*;
DATA ACCTS;
   SET OD FL HL ODHL;
   ACCT=1;
   IF  GRADEX NOT IN ('A','B','C','D','E')
       THEN GRADEX='X';
   BRCHCD=PUT(BRANCH,BRCHCD.);
*;
DATA E1271.ACCTS;
   SET ACCTS;
*;
DATA CRR;
  ACCT=0; BALANCE=0.00;
  DO BRANCH=2 TO 268;
     BRCHCD=PUT(BRANCH,BRCHCD.);

     CATG='OD';
     GRADEX='A'; OUTPUT;
     GRADEX='B'; OUTPUT;
     GRADEX='C'; OUTPUT;
     GRADEX='D'; OUTPUT;
     GRADEX='E'; OUTPUT;
     GRADEX='X'; OUTPUT;

     CATG='HL';
     GRADEX='A'; OUTPUT;
     GRADEX='B'; OUTPUT;
     GRADEX='C'; OUTPUT;
     GRADEX='D'; OUTPUT;
     GRADEX='E'; OUTPUT;
     GRADEX='X'; OUTPUT;

     CATG='FL';
     GRADEX='A'; OUTPUT;
     GRADEX='B'; OUTPUT;
     GRADEX='C'; OUTPUT;
     GRADEX='D'; OUTPUT;
     GRADEX='E'; OUTPUT;
     GRADEX='X'; OUTPUT;

     CATG='OL';
     GRADEX='A'; OUTPUT;
     GRADEX='B'; OUTPUT;
     GRADEX='C'; OUTPUT;
     GRADEX='D'; OUTPUT;
     GRADEX='E'; OUTPUT;
     GRADEX='X'; OUTPUT;
  END;
*;
DATA CRR;
  SET CRR;
  IF  BRCHCD EQ '  ' OR ('1'<=BRCHCD<='270') THEN DELETE;
*;
PROC SUMMARY DATA=ACCTS NWAY;
CLASS BRANCH GRADEX CATG; VAR ACCT BALANCE;
OUTPUT OUT=DRR (DROP=_FREQ_ _TYPE_) SUM=;
*;
PROC SORT DATA=CRR; BY BRANCH GRADEX CATG;
*;
DATA CRR;
   MERGE CRR(IN=A) DRR; BY BRANCH GRADEX CATG;
   IF A;
   FILE CRR;
   PUT @001 BRANCH    3.
       @005 GRADEX   $1.
       @007 CATG     $2.
       @010 ACCT      8.
       @020 BALANCE  12.2;

*;








