libname fccmart '/stgsrcsys/host/uat';

%macro load_cir_close;

    %local input_ds min_year max_year load_year
           row_count step_rc;

    /* Hardcode source */
    %let input_ds = fccmart.cir_close_102026;

    %if not %sysfunc(exist(&input_ds)) %then %do;
        %put ERROR: Source dataset &input_ds does not exist.;
        %let syscc = 8;
        %return;
    %end;

    /*==========================================================
      1. Select approvals from 1 Jan 2024 through today
         APPROVE_DATE is numeric SAS datetime
    ==========================================================*/

    data work._cir_close_ready(drop=_appr_day)
         work._cir_close_invalid_date(drop=_appr_day);

        set &input_ds;

        _appr_day = datepart(APPROVE_DATE);

        if missing(_appr_day) then
            output work._cir_close_invalid_date;

        else if _appr_day >= '01JAN2024'd
            and _appr_day <= today() then
            output work._cir_close_ready;
    run;

    %let step_rc = &syserr;

    %if &step_rc ne 0 %then %do;
        %put ERROR: Failed to prepare CIR_CLOSE records.;
        %let syscc = 8;
        %return;
    %end;

    /*==========================================================
      2. Determine approval-year range
    ==========================================================*/

    proc sql noprint;
        select count(*),
               min(year(datepart(APPROVE_DATE))),
               max(year(datepart(APPROVE_DATE)))
          into :row_count trimmed,
               :min_year trimmed,
               :max_year trimmed
        from work._cir_close_ready;
    quit;

    %if &sqlrc ne 0 %then %do;
        %put ERROR: Failed to determine approval years.;
        %let syscc = 8;
        %return;
    %end;

    %if &row_count = 0 %then %do;
        %put NOTE: No eligible records to load.;
        %return;
    %end;

    /*==========================================================
      3. Process each approval year
    ==========================================================*/

    %do load_year = &min_year %to &max_year;

        data work._cir_close_year;
            set work._cir_close_ready;
            where year(datepart(APPROVE_DATE)) = &load_year;
        run;

        %let step_rc = &syserr;

        %if &step_rc ne 0 %then %do;
            %put ERROR: Failed to prepare year &load_year.;
            %let syscc = 8;
            %return;
        %end;

        proc sql noprint;
            select count(*)
              into :row_count trimmed
            from work._cir_close_year;
        quit;

        %if &sqlrc ne 0 %then %do;
            %put ERROR: Failed to count year &load_year.;
            %let syscc = 8;
            %return;
        %end;

        %if &row_count > 0 %then %do;

            /* Start with existing yearly records, if any */
            %if %sysfunc(
                exist(fccmart.CIR_CLOSE_&load_year)
            ) %then %do;

                data work._cir_close_combined;
                    set fccmart.CIR_CLOSE_&load_year;
                run;

            %end;
            %else %do;

                /* Create empty dataset with source structure */
                data work._cir_close_combined;
                    set work._cir_close_year(obs=0);
                run;

            %end;

            %let step_rc = &syserr;

            %if &step_rc ne 0 %then %do;
                %put ERROR: Failed to prepare existing records for &load_year.;
                %let syscc = 8;
                %return;
            %end;

            /* Add incoming records to WORK first */
            proc append
                base=work._cir_close_combined
                data=work._cir_close_year;
            run;

            %let step_rc = &syserr;

            %if &step_rc ne 0 %then %do;
                %put ERROR: Failed to combine records for &load_year.;
                %put ERROR: Check source and target column structures.;
                %let syscc = 8;
                %return;
            %end;

            /*==================================================
              Compare ALL fields.
              Keep one record for each identical full row.
            ==================================================*/

            proc sort
                data=work._cir_close_combined
                out=work._cir_close_unique
                nodupkey;
                by _all_;
            run;

            %let step_rc = &syserr;

            %if &step_rc ne 0 %then %do;
                %put ERROR: Failed to remove duplicates for &load_year.;
                %let syscc = 8;
                %return;
            %end;

            /* Save existing + incoming unique records */
            data fccmart.CIR_CLOSE_&load_year;
                set work._cir_close_unique;
            run;

            %let step_rc = &syserr;

            %if &step_rc ne 0 %then %do;
                %put ERROR: Failed to save CIR_CLOSE_&load_year..;
                %let syscc = 8;
                %return;
            %end;

            proc sql noprint;
                select count(*)
                  into :row_count trimmed
                from fccmart.CIR_CLOSE_&load_year;
            quit;

            %if &sqlrc ne 0 %then %do;
                %put ERROR: Failed to count final records for &load_year.;
                %let syscc = 8;
                %return;
            %end;

            %put NOTE: FCCMART.CIR_CLOSE_&load_year contains &row_count unique records.;

        %end;

    %end;

%mend load_cir_close;


/* Run */
%load_cir_close;

/* Use within SAS DI where rcSet is already defined */
%rcSet(&syscc);
