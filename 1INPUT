*+--------------------------------------------------------------+               
 |  RM FD ACCEPTED BY ORIGINAL MATURITY                         |               
 +--------------------------------------------------------------+;              
%MACRO FDTBL;                                                                   
*;                                                                              
%INC PGM(PBBDPFMT);                                                             
*;                                                                              
DATA FDWKLY                                                                     
     (KEEP=BRANCH ACCTNO CUSTCODE NAME AMTIND                                   
           OPENIND CURBAL BIC INTPAY STATE TERM);                               
     LENGTH CUSTCODE $2. BIC $5.;                                               
     SET FD.FD;                                                                 
     BIC = PUT(INTPLAN, FDPROD.);                                               
     AMTIND=PUT(INTPLAN, FDDENOM.);                                             
     STATE = PUT(BRANCH, STATECD.);                                             
     IF BIC = '42130' THEN CUSTCODE = PUT(CUSTCD, FDCUSTCD.);                   
        ELSE CUSTCODE = PUT(CUSTCD, IFDCUSCD.);                                 
     IF OPENIND = 'O' OR OPENIND = 'D' THEN OUTPUT;                             
RUN;                                                                            
*;                                                                              
PROC SUMMARY DATA = FDWKLY NWAY;                                                
   CLASS BIC OPENIND TERM CUSTCODE AMTIND;                                      
   VAR CURBAL;                                                                  
   OUTPUT OUT = ALW                                                             
          SUM = AMOUNT;                                                         
RUN;                                                                            
*;                                                                              
DATA ALWDEPT (KEEP=BNMCODE AMTIND AMOUNT FDTYP);                                
   LENGTH BNMCODE $14.;                                                         
   SET ALW;                                                                     
   WHERE BIC = '42130';                                                         
                                                                                
   OM=PUT(TERM,FDORGMT.);                                                       
   BNMCODE=BIC||'00'||OM||'0000Y';                                              
                                                                                
   SELECT (OM);                                                                 
     WHEN('12') FDTYP=1;                                                        
     WHEN('13') FDTYP=2;                                                        
     WHEN('14') FDTYP=3;                                                        
     WHEN('15') FDTYP=4;                                                        
     WHEN('16') FDTYP=5;                                                        
     WHEN('17') FDTYP=6;                                                        
     WHEN('21') FDTYP=7;                                                        
     WHEN('22') FDTYP=8;                                                        
     WHEN('23') FDTYP=9;                                                        
     WHEN('24') FDTYP=10;                                                       
     WHEN('25') FDTYP=11;                                                       
     WHEN('26') FDTYP=12;                                                       
     WHEN('30') FDTYP=13;                                                       
     OTHERWISE;                                                                 
   END;                                                                         
RUN;                                                                            
*;                                                                              
PROC SUMMARY DATA=ALWDEPT NWAY;                                                 
CLASS BNMCODE FDTYP;                                                            
VAR   AMOUNT;                                                                   
OUTPUT OUT=ALWDEPT                                                              
       SUM=;                                                                    
RUN;                                                                            
*;                                                                              
PROC PRINT DATA=ALWDEPT LABEL;                                                  
VAR BNMCODE FDTYP AMOUNT;                                                       
SUM AMOUNT;                                                                     
LABEL BNMCODE = 'ITEM CODE'                                                     
      AMOUNT  = 'AMOUNT'                                                        
      FDTYP   = 'DESCRIPTION';                                                  
FORMAT FDTYP FDTYPF. AMOUNT COMMA20.2;                                          
TITLE3 'RM FIXED DEPOSIT ACCEPTED BY ORIGINAL MATURITY AS AT ' "&RDATE";        
RUN;                                                                            
*;                                                                              
%MEND FDTBL;                                                                    
*;                                                                              
*+--------------------------------------------------------------+               
 |  LOANS TO SMIS BY SECTOR                                     |               
 +--------------------------------------------------------------+;              
%MACRO LNTBL1;                                                                  
*;                                                                              
PROC SUMMARY DATA=BNM.LOAN&REPTMON&NOWK;                                        
VAR BALANCE;                                                                    
CLASS AMTIND SECTORCD CUSTCD;                                                   
WHERE SUBSTR(PRODCD, 1, 2) = '34';                                              
OUTPUT OUT=ALW                                                                  
       SUM=AMOUNT;                                                              
RUN;                                                                            
*;                                                                              
DATA ALWLOAN (KEEP=BNMCODE AMTIND AMOUNT);                                      
  LENGTH BNMCODE $14.;                                                          
  SET ALW;                                                                      
                                                                                
  IF _TYPE_=7 THEN DO;                                                          
     IF SUBSTR(SECTORCD,1,2) IN ('01') THEN DO;                                 
        SELECT(CUSTCD);                                                         
           WHEN('66','67','68','69') DO;                                        
             BNMCODE='3400065000100Y'; OUTPUT;                                  
           END;                                                                 
          OTHERWISE;                                                            
        END;                                                                    
     END;                                                                       
                                                                                
     IF SUBSTR(SECTORCD,1,3) IN ('031','032') THEN DO;                          
        IF SUBSTR(SECTORCD,1,3) IN ('031') THEN SECTORCD='0310';                
        ELSE SECTORCD='0320';                                                   
        SELECT(CUSTCD);                                                         
           WHEN('66','67','68','69') DO;                                        
             BNMCODE='340006500'||SECTORCD||'Y'; OUTPUT;                        
           END;                                                                 
          OTHERWISE;                                                            
        END;                                                                    
     END;                                                                       
                                                                                
     IF SUBSTR(SECTORCD,1,1) IN ('1','2','3','4','5','6','7') OR                
        SUBSTR(SECTORCD,1,2) IN ('61','62','63') OR                             
        SUBSTR(SECTORCD,1,3) IN ('831','832','833') THEN DO;                    
        SELECT;                                                                 
          WHEN(SUBSTR(SECTORCD,1,1)='1') SECTORCD='1000';                       
          WHEN(SUBSTR(SECTORCD,1,1)='2') SECTORCD='2000';                       
          WHEN(SUBSTR(SECTORCD,1,1)='3') SECTORCD='3000';                       
          WHEN(SUBSTR(SECTORCD,1,1)='4') SECTORCD='4000';                       
          WHEN(SUBSTR(SECTORCD,1,1)='5') SECTORCD='5000';                       
          WHEN(SUBSTR(SECTORCD,1,1)='7') SECTORCD='7000';                       
          WHEN(SUBSTR(SECTORCD,1,2)='61') SECTORCD='6100';                      
          WHEN(SUBSTR(SECTORCD,1,2)='62') SECTORCD='6200';                      
          WHEN(SUBSTR(SECTORCD,1,2)='63') SECTORCD='6300';                      
          WHEN(SUBSTR(SECTORCD,1,3)='831') SECTORCD='8310';                     
          WHEN(SUBSTR(SECTORCD,1,3)='832') SECTORCD='8320';                     
          WHEN(SUBSTR(SECTORCD,1,3)='833') SECTORCD='8330';                     
          OTHERWISE;                                                            
        END;                                                                    
                                                                                
        IF CUSTCD IN ('65','66','67','68','69') THEN DO;                        
            BNMCODE='340006500'||SECTORCD||'Y'; OUTPUT;                         
        END;                                                                    
     END;                                                                       
                                                                                
     IF SUBSTR(SECTORCD,1,1) IN ('9') THEN DO;                                  
        IF SECTORCD ^= '9999' THEN SECTORCD='9000';                             
        IF CUSTCD IN ('66','67','68','69') THEN DO;                             
           BNMCODE='340006500'||SECTORCD||'Y'; OUTPUT;                          
        END;                                                                    
     END;                                                                       
  END;                                                                          
RUN;                                                                            
*;                                                                              
DATA ALW (KEEP=BNMCODE AMTIND AMOUNT LNTYP1);                                   
 SET ALWLOAN;                                                                   
   SELECT;                                                                      
     WHEN(SUBSTR(BNMCODE,10,4)='0100') LNTYP1=1;                                
     WHEN(SUBSTR(BNMCODE,10,4)='0300') LNTYP1=2;                                
     WHEN(SUBSTR(BNMCODE,10,4)='0310') LNTYP1=3;                                
     WHEN(SUBSTR(BNMCODE,10,4)='0320') LNTYP1=4;                                
     WHEN(SUBSTR(BNMCODE,10,4)='1000') LNTYP1=5;                                
     WHEN(SUBSTR(BNMCODE,10,4)='2000') LNTYP1=6;                                
     WHEN(SUBSTR(BNMCODE,10,4)='3000') LNTYP1=7;                                
     WHEN(SUBSTR(BNMCODE,10,4)='4000') LNTYP1=8;                                
     WHEN(SUBSTR(BNMCODE,10,4)='5000') LNTYP1=9;                                
     WHEN(SUBSTR(BNMCODE,10,4)='6000') LNTYP1=10;                               
     WHEN(SUBSTR(BNMCODE,10,4)='6100') LNTYP1=11;                               
     WHEN(SUBSTR(BNMCODE,10,4)='6200') LNTYP1=12;                               
     WHEN(SUBSTR(BNMCODE,10,4)='6300') LNTYP1=13;                               
     WHEN(SUBSTR(BNMCODE,10,4)='7000') LNTYP1=14;                               
     WHEN(SUBSTR(BNMCODE,10,4)='8300') LNTYP1=15;                               
     WHEN(SUBSTR(BNMCODE,10,4)='8310') LNTYP1=16;                               
     WHEN(SUBSTR(BNMCODE,10,4)='8320') LNTYP1=17;                               
     WHEN(SUBSTR(BNMCODE,10,4)='8330') LNTYP1=18;                               
     WHEN(SUBSTR(BNMCODE,10,4)='9000') LNTYP1=19;                               
     WHEN(SUBSTR(BNMCODE,10,4)='9999') LNTYP1=20;                               
     OTHERWISE;                                                                 
   END;                                                                         
RUN;                                                                            
*;                                                                              
PROC SUMMARY DATA=ALW NWAY;                                                     
CLASS BNMCODE LNTYP1;                                                           
VAR   AMOUNT;                                                                   
OUTPUT OUT=ALWLOAN                                                              
       SUM=;                                                                    
RUN;                                                                            
*;                                                                              
PROC PRINT DATA=ALWLOAN LABEL;                                                  
VAR BNMCODE LNTYP1 AMOUNT;                                                      
SUM AMOUNT;                                                                     
LABEL BNMCODE='ITEM CODE'                                                       
      AMOUNT = 'AMOUNT'                                                         
      LNTYP1='DESCRIPTION';                                                     
FORMAT LNTYP1 LNTYP1F. AMOUNT COMMA20.2;                                        
TITLE3 'LOANS TO SMIS BY SECTOR AS AT ' "&RDATE";                               
RUN;                                                                            
*;                                                                              
%MEND LNTBL1;                                                                   
*;                                                                              
*+--------------------------------------------------------------+               
 |  GROSS LOANS BY TYPE OF REPRICING                            |               
 +--------------------------------------------------------------+;              
%MACRO LNTBL2;                                                                  
*;                                                                              
%INC PGM(PBBLNFMT);                                                             
*;                                                                              
PROC SUMMARY DATA=BNM.LOAN&REPTMON&NOWK NWAY MISSING;                           
CLASS PRODCD PRODUCT USURYIDX AMTIND;                                           
VAR   BALANCE;                                                                  
WHERE SUBSTR(PRODCD, 1, 2) = '34' OR SUBSTR(PRODCD,1,2)='54';                   
OUTPUT OUT=ALW                                                                  
       SUM=AMOUNT;                                                              
RUN;                                                                            
*;                                                                              
DATA ALWLOAN (KEEP=BNMCODE AMTIND AMOUNT);                                      
  LENGTH BNMCODE $14.;                                                          
  SET ALW;                                                                      
                                                                                
  IF PRODCD IN ('34180','34240','34380') THEN                                   
     BIC = PUT(PRODUCT,ODRATE.);                                                
  ELSE BIC = PUT(PRODUCT,LNRATE.);                                              
  IF BIC ^= ' ';                                                                
     BNMCODE=BIC||'00000000Y'; OUTPUT;                                          
*;                                                                              
DATA ALW (KEEP=BNMCODE AMTIND AMOUNT LNTYP2);                                   
 SET ALWLOAN;                                                                   
   SELECT;                                                                      
     WHEN(SUBSTR(BNMCODE,5,1)='1') LNTYP2=1;                                    
     WHEN(SUBSTR(BNMCODE,5,1)='2') LNTYP2=2;                                    
     WHEN(SUBSTR(BNMCODE,5,1)='3') LNTYP2=3;                                    
     WHEN(SUBSTR(BNMCODE,5,1)='4') LNTYP2=4;                                    
     WHEN(SUBSTR(BNMCODE,5,1)='5') LNTYP2=5;                                    
     WHEN(SUBSTR(BNMCODE,5,1)='6') LNTYP2=6;                                    
     WHEN(SUBSTR(BNMCODE,5,1)='7') LNTYP2=7;                                    
     OTHERWISE;                                                                 
   END;                                                                         
RUN;                                                                            
*;                                                                              
PROC SUMMARY DATA=ALW NWAY;                                                     
CLASS BNMCODE LNTYP2;                                                           
VAR   AMOUNT;                                                                   
OUTPUT OUT=ALWLOAN                                                              
       SUM=;                                                                    
RUN;                                                                            
*;                                                                              
PROC PRINT DATA=ALWLOAN LABEL;                                                  
VAR BNMCODE LNTYP2 AMOUNT;                                                      
SUM AMOUNT;                                                                     
LABEL BNMCODE='ITEM CODE'                                                       
      AMOUNT = 'AMOUNT'                                                         
      LNTYP2='DESCRIPTION';                                                     
FORMAT LNTYP2 LNTYP2F. AMOUNT COMMA20.2;                                        
TITLE3 'GROSS LOANS BY TYPE OF REPRICING AS AT ' "&RDATE";                      
RUN;                                                                            
*;                                                                              
%MEND LNTBL2;                                                                   
