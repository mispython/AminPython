folder_path = Path("/sasdata/rawdata/deposit/roms")

target_list = [
    "Forex_Long_Format_DP_PBB",
    "Forex_Long_Format_DP_PIB",
    "Forex_Long_Format_DP_EXCP_PBB",
    "Forex_Long_Format_DP_EXCP_PIB",
