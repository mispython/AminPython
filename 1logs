dttm = datetime.now() #- timedelta(days=1)

def get_filename():
    # Return YYMMDD_HHMMSS based on current time
    if len(sys.argv[-1]) == 6:
        suffix = sys.argv[-1]
    elif dttm.time() < time( 9, 15):
        suffix = "084500"
    elif dttm.time() < time(16, 45):
        suffix = "091500"       
    elif dttm.time() < time(17, 15):
        suffix = "164500" 
    elif dttm.time() < time(17, 45):
        suffix = "171500"
    elif dttm.time() < time(18, 15):
        suffix = "174500"
    elif dttm.time() < time(18, 30):
        suffix = "181500"
    else:
        suffix = "183000"
    return dttm.strftime(f"%y%m%d_{suffix}")

def xcmd(command: str):
    try:
        result = subprocess.run(command, shell=True, text=True, capture_output=True, check=True)
        print(result.stdout)
    except subprocess.CalledProcessError as e:
        print(f"[ERROR] {e}")
        print(e.stderr)
        sys.exit(e.returncode)
    return
       
def csv_to_excel(input_path):
    print(f"[INFO] Searching for conversion in folder: {input_path}")

    suffix = get_filename()
    target_files = [f"{prefix}_{suffix}.CSV" for prefix in target_list]
    print(target_files)

    converted_files = []

    # Locate CSV files (case sensetive)
    for csv_file in [f for f in input_path.glob("*.CSV") if f.name in target_files]:
        print(f"[INFO] Processing: {csv_file.name}")

        try:
            # Read CSV
            df = pd.read_csv(csv_file, encoding="utf-8", dtype=str)
            df = df.loc[:, ~df.columns.str.match('Unnamed') & (df.columns.str.strip() != "")] #Drop unnamed columns
            print(*df, sep='\n')
            df = df.apply(lambda col: col.map(lambda x: x.strip() if isinstance(x, str) else x))

            # Write to Excel            
            xlsx_file = csv_file.with_suffix(".xlsx")

            with pd.ExcelWriter(xlsx_file, engine="openpyxl") as writer:
                df.to_excel(writer, index=False, sheet_name="Sheet1")
                ws = writer.sheets["Sheet1"]

                # Autofit Columns
                for column_cells in ws.columns:
                    max_len = max(
                        len(str(cell.value)) if cell.value is not None else 0
                        for cell in column_cells
                    )
                    ws.column_dimensions[column_cells[0].column_letter].width = max_len + 2  # small padding
                                                 
            print(f"[INFO] Converted: {xlsx_file.name}\n")
            converted_files.append(xlsx_file.name)

        except Exception as e:
            print(f"[ERROR] {csv_file}: {e}")
          
    if converted_files:
        print("All CSV files converted successfully!")
        # SFTP to Menara File Server
