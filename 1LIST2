libname a ('/dwh/dpd_fd','/dwh/idpd_fd','/dwh/idp_fcy','/dwh/dp_fcy');

data DEPO(KEEP=ACCTNO BRANCH SECOND2);
	set a.fd261127 a.ifd261127 a.ifcy261127(DROP=PURPOSE) a.fcy261127(DROP=PURPOSE);
/*DROP PURPOSE DUE TO DIFFERENT FORMAT TYPE.*/
	   FORMAT SECOND2 $4.;
   IF SECOND IN (99991,99992);
   IF SECOND = 99991 THEN SECOND2 = 'PBB';
   IF SECOND = 99992 THEN SECOND2 = 'PIBB';
run;


PROC SORT DATA=DEPO; BY ACCTNO BRANCH; RUN;

libname a3 ('/sas/deposit/dwh/integration');

DATA FDNAME(KEEP=ACCTNO BRANCH NAME);
	set a3.INTG_DP_ACCT_FD_D27;
run;
PROC SORT DATA=FDNAME; BY ACCTNO BRANCH; RUN;

data DEPO1(KEEP=ACCTNO BRANCH SECOND2 NAME);
	merge DEPO(IN=A) FDNAME(IN=B);
	BY ACCTNO BRANCH;
	IF A;
run;

PROC SORT DATA=DEPO1; BY ACCTNO BRANCH; RUN;


libname a2 ('/sas/deposit/dwh/enrichment');

DATA DEPO2(KEEP=ACCTNO BRANCH CDNO MATDATE TERM RT CURR_BAL);
/*DATA DEPO2;*/
	set a2.enrh_dp_fd_cert_d27;
	ACCTNO=ACCT_NUM;  BRANCH=BRANCH_CD;
	CDNO=CERT_NUM;
	MATDATE = DATEPART(MATURE_DT);
   IF CURR_BAL > 0;
   FORMAT MATDATE YYMMDDN8.;
run;PROC SORT DATA=DEPO2; BY ACCTNO BRANCH; RUN;

DATA ALL;
   MERGE DEPO1(IN=A) DEPO2(IN=B); BY ACCTNO BRANCH;
   IF A AND B;
RUN;
PROC SORT DATA=ALL; BY MATDATE; RUN;

DATA FD
     FCYFD;
   SET ALL;
   IF (1590000000<=ACCTNO<=1599999999) OR
      (1689999999<=ACCTNO<=1699999999) OR
      (1789999999<=ACCTNO<=1799999999) THEN OUTPUT FCYFD;
   ELSE                OUTPUT FD;
RUN;



