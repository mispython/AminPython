EIBMLIQ3 reads 14 SAS members and one sequential date file across 11 DD names.
DD / SAS libref	Mainframe data set	Required member or record
BNMTBL1	SAP.PBB.KAPITI1(0)	First record, columns 1–8, containing the report date in YYYYMMDD format
BNMK	SAP.PBB.KAPITI.SASDATA	K1TBL&REPTMON&WK4, K3TBL&REPTMON&WK4
BNM1	SAP.PBB.D%TOYYYY	ALW&REPTMON&WK4, W1AL&REPTMON&WK4
EQ1	SAP.PBB.WEQUT(0)	UTMS&REPTMON&WK4&YEAR, UTFX&REPTMON&WK4&YEAR, UTRP&REPTMON&WK4&YEAR
SIP	SAP.PBB.SIP(0)	SIPCERT&REPTMON&WK4&YEAR
DCI	SAP.PBB.DCIWH	DCI&REPTMON&WK4
FD	SAP.PBB.FDDATAWH	FD&REPTMON&NOWK&REPTYEAR
FCY	SAP.BNM.MONTHEND.FCDATAWH	FCY&REPTMON&NOWK&REPTYEAR
CA	SAP.PBB.CADATAWH	CA&REPTMON&NOWK&REPTYEAR
CIS	SAP.PBB.CIDATAWH	CISR1FD&REPTMON&NOWK&REPTYEAR, CISR1CA&REPTMON&NOWK&REPTYEAR
FORATE	SAP.PBB.FCYCA	FORATEBKP


"""EIBMLIQ3 native Python job. Includes all five ratios."""
import argparse
from calendar import monthrange
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

def month_end(run_date=None):
    if run_date is None:
        run_date = datetime.now(timezone(timedelta(hours=8))).date()
    return run_date.replace(day=1) - timedelta(days=1)


def input_paths(report_date):
    month = report_date.strftime("%m") + "4"
    period = month + report_date.strftime("%y")
    return {
        f"BNMK.K1TBL{month}": f"/exdwh/host/kapiti/k1tbl{month}.sas7bdat",
        f"BNMK.K3TBL{month}": f"/exdwh/host/kapiti/k3tbl{month}.sas7bdat",
        f"BNM1.ALW{month}": f"/dwh/dwh_m/tempsource/ALW{month}.sas7bdat",
        f"BNM1.W1AL{month}": f"/dwh/dwh_m/tempsource/W1AL{month}.sas7bdat",
        **{
            f"EQ1.{member.upper()}{period}": f"/dwh/eq_d/{member}{period}.sas7bdat"
            for member in ("utms", "utfx", "utrp")
        },
        f"SIP.SIPCERT{period}": f"/dwh/rs_cis/sipcust{period}.sas7bdat",
        f"DCI.DCI{month}": f"/dwh/dci/dci{month}.sas7bdat",
        f"FD.FD{period}": f"/dwh/dp_fd/fd{period}.sas7bdat",
        f"FCY.FCY{period}": f"/dwh/dp_fcy/fcy{period}.sas7bdat",
        f"CA.CA{period}": f"/dwh/dp_ca/ca{period}.sas7bdat",
        f"CIS.CISR1FD{period}": f"/dwh/rs_cis/cisr1fd{period}.sas7bdat",
        f"CIS.CISR1CA{period}": f"/dwh/rs_cis/cisr1ca{period}.sas7bdat",
        "FORATE.FORATEBKP": "/host_pq/dwh/sas/lkp_spotrate.sas7bdat",
    }



def load_inputs(run_date=None, members=None):
    """Return the reporting date and frames indexed by original SAS member."""
    report_date = month_end(run_date)
    paths = input_paths(report_date)
    if members is not None:
        paths = {member: path for member, path in paths.items() if member.rstrip("0123456789") in members}
    missing = [path for path in paths.values() if not Path(path).is_file()]
    if missing:
        raise FileNotFoundError("Missing month-end inputs:\n" + "\n".join(missing))

    import pyreadstat

    frames = {}
    for member, path in paths.items():
        frame, _ = pyreadstat.read_sas7bdat(path, disable_datetime_conversion=True)
        frame.columns = frame.columns.str.upper()
        frames[member] = frame
    return report_date, frames

# SAS dates are retained as numeric day counts by the input reader.
REPO_CODES = {
    "4216017000000Y", "4216020000000Y", "4216060000000Y",
    "4216071000000Y", "4216072000000Y", "4216073000000Y",
    "4216074000000Y", "4216076000000Y", "4216079000000Y",
    "4216085000000Y",
}
EXCLUDED_DEPOSITS = {"C1.03E", "C1.03F", "C1.03K"}


def text_column(frame, name):
    return frame[name].fillna("").str.rstrip(" ")


def macro_amount(value):
    """Match an eight-decimal SAS macro amount, preserving missing values."""
    return None if value is None else float(f"{value:.8f}")


def difference(left, right):
    return None if left is None or right is None else left - right


def pbl_deposits(fd, fcy, cis):
    """Apply the account lookup and retain the PB(L) customer balances."""
    lookup = cis.loc[cis["SECCUST"].eq(901), ["ACCTNO", "CUSTNO"]].copy()
    lookup = lookup.drop_duplicates("ACCTNO").rename(columns={"CUSTNO": "_CIS_CUSTNO"})
    lookup["_IN_CIS"] = True

    def select(frame):
        merged = frame.merge(lookup, how="left", on="ACCTNO", validate="many_to_one")
        customer = merged["_CIS_CUSTNO"]
        if "CUSTNO" in merged:
            customer = customer.where(merged["_IN_CIS"].eq(True), merged["CUSTNO"])
        return merged.loc[customer.eq(3721354)]

    fd = select(fd)
    fcy = select(fcy.loc[fcy["PRODUCT"].between(300, 399)])
    return sum(
        frame[column].sum()
        for frame in (fd, fcy)
        for column in ("CURBAL", "CURBALRM")
        if column in frame
    )


def ratio1(report_date, frames):
    """Return Ratio 1 rows in report order."""
    month = report_date.strftime("%m") + "4"
    period = month + report_date.strftime("%y")
    alw = frames[f"BNM1.ALW{month}"]
    w1al = frames[f"BNM1.W1AL{month}"]
    utms = frames[f"EQ1.UTMS{period}"]

    mapped = text_column(w1al, "SET_ID").map(W1AL_ITEMS)
    amounts = w1al["AMOUNT"].groupby(mapped).sum().to_dict()

    repo = text_column(alw, "AMTIND").ne("") & text_column(alw, "ITCODE").isin(REPO_CODES)
    if repo.any():
        amounts["C1.04"] = alw.loc[repo, "AMOUNT"].sum()

    # SAS orders numeric missing values below ordinary dates.
    value_date, business_date = utms["VALUDATE"], utms["BUSDATE"]
    eligible = (
        ~text_column(utms, "DEALTYPE").isin({"MOP", "MSP", "IUP"})
        & text_column(utms, "SECTYPE").ne("DIM")
        & text_column(utms, "PORTREF").ne("SIPPFD")
        & (value_date.isna() | value_date.le(business_date))
        & (
            text_column(utms, "CUSTFISS").isin({"01", "02", "03", "07", "12", "81", "82", "83", "84"})
            | text_column(utms, "CUSTEQTP").isin({"BC", "BB", "BI", "BJ", "BM", "BA", "BE"})
        )
    )
    if eligible.any():
        amounts["C1.05B"] = utms.loc[eligible, "CAMTOWNE"].sum()

    amounts["C1.03M"] = pbl_deposits(
        frames[f"FD.FD{period}"],
        frames[f"FCY.FCY{period}"],
        frames[f"CIS.CISR1FD{period}"],
    )
    loan = difference(macro_amount(amounts.get("C1.01")), amounts.get("C1.02"))
    nids = difference(macro_amount(amounts.get("C1.05A")), macro_amount(amounts.get("C1.05B")))
    for item in EXCLUDED_DEPOSITS:
        amounts[item] = 0.0
    amounts["C1.03"] = (
        sum(value for item, value in amounts.items() if item.startswith("C1.03"))
        - 2 * macro_amount(amounts["C1.03M"])
    )
    amounts["C1.05"] = nids
    additions = ("C1.03", "C1.04", "C1.05", "C1.07", "C1.08", "C1.09", "C1.10")
    components = [macro_amount(amounts.get(item)) for item in additions]
    deposit = difference(sum(value for value in components if value is not None),
                         macro_amount(amounts.get("C1.06")))
    ratio = None if loan is None or not deposit else macro_amount(loan) / deposit * 100

    rows = []
    for number, (item, label) in enumerate(RATIO1_LAYOUT, 1):
        group = "ADJUSTED LOAN" if number <= 2 else "ADJUSTED DEPOSIT"
        rows.append((group, item, label, amounts.get(item)))
        if number == 2:
            rows.append((group, "SUB-TOTAL", "", macro_amount(loan)))
    rows.append(("ADJUSTED DEPOSIT", "SUB-TOTAL", "", macro_amount(deposit)))
    rows.append(("RATIO", "." if ratio is None else f"{ratio:.8f}", "", None))
    return rows


def rate_percentage(numerator, denominator):
    if numerator is None or denominator is None or denominator == 0:
        return "."
    return f"{numerator / denominator * 100:.8f}"


def sas_sum(values):
    present = [value for value in values if value is not None]
    return sum(present) if present else None


def ca_pbl_amounts(ca, cis):
    """Reproduce a SAS BY merge, pairing duplicates by input order."""
    lookup = cis.loc[cis["SECCUST"].eq(901), ["ACCTNO", "CUSTNO"]]
    left = ca.assign(_CA=True)
    right = lookup.rename(columns={"CUSTNO": "_CIS_CUSTNO"}).assign(_CIS=True)
    left = left.assign(_SEQ=left.groupby("ACCTNO", dropna=False).cumcount())
    right = right.assign(_SEQ=right.groupby("ACCTNO", dropna=False).cumcount())
    merged = left.merge(right, how="outer", on=["ACCTNO", "_SEQ"]).sort_values("_SEQ")
    # Retain the last CA row for lookup-only iterations within a BY group.
    merged["_CA_SEQ"] = merged["_SEQ"].where(merged["_CA"].eq(True))
    merged["_CA_SEQ"] = merged.groupby("ACCTNO", dropna=False)["_CA_SEQ"].ffill()
    retained = merged[["ACCTNO", "_CA_SEQ"]].merge(
        left[["ACCTNO", "_SEQ", "PRODUCT", "CURBAL"]],
        how="left", left_on=["ACCTNO", "_CA_SEQ"], right_on=["ACCTNO", "_SEQ"],
    )
    customer = merged["_CIS_CUSTNO"]
    if "CUSTNO" in merged:
        customer = customer.where(merged["_CIS"].eq(True), merged["CUSTNO"])
    valid = customer.eq(3721354).to_numpy() & retained["PRODUCT"].isin({104, 105, 147}).to_numpy()
    return retained.loc[valid, "CURBAL"]


def ratio2(report_date, frames, ratio1_rows):
    month = report_date.strftime("%m") + "4"
    period = month + report_date.strftime("%y")
    ratio1_amounts = {item: amount for _, item, _, amount in ratio1_rows}
    pbl_fd = macro_amount(ratio1_amounts["C1.03M"])
    alw = frames[f"BNM1.ALW{month}"]
    w1al = frames[f"BNM1.W1AL{month}"]
    sip = frames[f"SIP.SIPCERT{period}"]
    utfx = frames[f"EQ1.UTFX{period}"]
    utms = frames[f"EQ1.UTMS{period}"]
    rates = frames["FORATE.FORATEBKP"].copy()

    walker = w1al["AMOUNT"].groupby(text_column(w1al, "SET_ID")).sum().to_dict()
    valid_alw = alw.loc[text_column(alw, "AMTIND").ne("")]
    alw_codes = valid_alw["AMOUNT"].groupby(text_column(valid_alw, "ITCODE")).sum()
    alw_items = {}
    for code, amount in alw_codes.items():
        item = RATIO2_ALW_ITEMS.get(code)
        if item is None:
            continue
        if item == "C2.04E":
            amount = difference(amount, macro_amount(walker.get("F143620LKR")))
        elif item == "C2.08D":
            amount = difference(amount, macro_amount(walker.get("F133620LKR")))
        alw_items[item] = (alw_items.get(item) or 0.0) + (amount or 0.0)

    start = utfx["STRTDATE"]
    started = start.isna() | start.le(utfx["BUSDATE"])
    deal_type = text_column(utfx, "DEALTYPE")
    cust_fiss = text_column(utfx, "CUSTFISS")
    cust_eqtp = text_column(utfx, "CUSTEQTP")
    pbl = text_column(utfx, "CUSTID").eq("BR 900002A")
    basic_type = text_column(utfx, "BASICTYP")
    nfe_fx = started & deal_type.isin({"BCD", "BCI", "BCQ"}) & (
        cust_fiss.between("80", "99") | cust_eqtp.isin({"EB", "BA", "CE", "BE", "GA"})
    )
    fx_borrow = started & pbl & basic_type.eq("D") & ~deal_type.isin({"BCC", "BCD", "BCQ"})
    fx_place = started & pbl & basic_type.eq("L") & ~deal_type.isin({"BCD", "BCQ", "LCC"})

    sas_date = (report_date - date(1960, 1, 1)).days
    rates["CURCODE"] = text_column(rates, "CURCODE")
    rates = rates.loc[rates["REPTDATE"].isna() | rates["REPTDATE"].le(sas_date)]
    rates = rates.sort_values("REPTDATE", ascending=False, kind="stable", na_position="last")
    spot = rates.drop_duplicates("CURCODE").set_index("CURCODE")["SPOTRATE"]
    borrow_fx = utfx.loc[fx_borrow, "AMTPAY"] * text_column(utfx.loc[fx_borrow], "PURCHCUR").map(spot)
    place_fx = utfx.loc[fx_place, "AMTPAY"] * text_column(utfx.loc[fx_place], "SALESCUR").map(spot)

    nids = (
        ~text_column(utms, "DEALTYPE").isin({"MOP", "MSP", "IUP"})
        & text_column(utms, "SECTYPE").ne("DIM")
        & text_column(utms, "PORTREF").ne("SIPPFD")
        & (utms["VALUDATE"].isna() | utms["VALUDATE"].le(utms["BUSDATE"]))
        & text_column(utms, "CUSTNO").eq("PBLNID")
    )
    sip_eligible = sip["INVSTAT"].ne(601) & sip["CUSTCODE"].between(80, 99)
    ca_balances = ca_pbl_amounts(frames[f"CA.CA{period}"], frames[f"CIS.CISR1CA{period}"])
    amounts = dict(alw_items)
    amounts["C2.01L"] = pbl_fd
    if nfe_fx.any():
        amounts["C2.01F"] = utfx.loc[nfe_fx, "AMTPAY"].sum()
    if nids.any():
        amounts["C2.02C"] = utms.loc[nids, "CAMTOWNE"].sum()
    if not ca_balances.empty:
        amounts["C2.04G"] = ca_balances.sum()
    if not borrow_fx.empty:
        amounts["C2.04I"] = borrow_fx.sum()
    if not place_fx.empty:
        amounts["C2.08F"] = place_fx.sum()
    for item, set_id in (("C2.04H", "F242699PBL"), ("C2.08E", "F133690VFBI")):
        if set_id in walker:
            amounts[item] = walker[set_id]

    def section_sum(prefix, values, has_rows=False):
        section = [amount for item, amount in values.items() if item.startswith(prefix)]
        return sum(value or 0.0 for value in section) if section or has_rows else None

    exclusions = {"C2.01D", "C2.01E", "C2.01J"}
    section201 = {item: amount for item, amount in alw_items.items() if item not in exclusions}
    for item in exclusions.intersection(alw_items):
        section201[item] = 0.0
    if "C2.01F" in amounts:
        section201["C2.01F"] = amounts["C2.01F"]

    borrow_adjustment = macro_amount(sas_sum([amounts.get(item) for item in ("C2.04G", "C2.04H", "C2.04I")]))
    placement_inputs = dict(alw_items)
    if "C2.08E" in amounts:
        placement_inputs["C2.08E"] = amounts["C2.08E"]
    totals = {
        "C2.01": difference(section_sum("C2.01", section201, sip_eligible.any()), pbl_fd),
        "C2.02": difference(section_sum("C2.02", alw_items), macro_amount(amounts.get("C2.02C", 0))),
        "C2.03": section_sum("C2.03", alw_items),
        "C2.04": difference(section_sum("C2.04", alw_items), borrow_adjustment),
        "C2.08": difference(section_sum("C2.08", placement_inputs), macro_amount(amounts.get("C2.08F"))),
    }
    borrow = sas_sum([totals[item] for item in ("C2.01", "C2.02", "C2.03", "C2.04")])
    placements = totals["C2.08"]
    offshore = difference(macro_amount(borrow), placements)
    totals.update({
        "C2.09": difference(macro_amount(ratio1_amounts["C1.03"]), macro_amount(totals["C2.01"])),
        "C2.10": difference(macro_amount(ratio1_amounts["C1.04"]), macro_amount(amounts.get("C2.03B"))),
        "C2.11": difference(macro_amount(ratio1_amounts["C1.05"]), macro_amount(amounts.get("C2.02B"))),
    })
    domestic = sas_sum([macro_amount(totals[item]) for item in ("C2.09", "C2.10", "C2.11")])
    amounts.update(totals)
    amounts.update(dict.fromkeys(exclusions, 0.0))

    borrowing = "NET OFFSHORE BORROWING(ACCEPTANCE)"
    less = "LESS"
    liabilities = "TOTAL DOMESTIC DEPOSIT LIABILITIES"
    rows = []
    for item, label in RATIO2_LAYOUT:
        group = borrowing if item[:5] <= "C2.04" else less if item[:5] <= "C2.08" else liabilities
        rows.append((group, item, label, amounts.get(item)))
        if item == "C2.04I":
            rows.append((group, "SUB-TOTAL", "", macro_amount(borrow)))
        elif item == "C2.08F":
            rows.extend([(group, "SUB-TOTAL", "", macro_amount(placements)),
                         (group, "TOTAL", "", macro_amount(offshore))])
    rows.append((liabilities, "SUB-TOTAL", "", macro_amount(domestic)))
    rows.append(("RATIO", rate_percentage(macro_amount(offshore), domestic), "", None))
    return rows




def domestic_interbank_utms(utms):
    value_date, business_date = utms["VALUDATE"], utms["BUSDATE"]
    return (
        ~text_column(utms, "DEALTYPE").isin({"MOP", "MSP", "IUP"})
        & text_column(utms, "SECTYPE").ne("DIM")
        & text_column(utms, "PORTREF").ne("SIPPFD")
        & (value_date.isna() | value_date.le(business_date))
        & (text_column(utms, "CUSTFISS").isin({"01", "02", "03", "07", "12"})
           | text_column(utms, "CUSTEQTP").isin({"BC", "BB", "BI", "BJ", "BM"}))
    )


def ratio3(report_date, frames, ratio2_rows):
    """Calculate net domestic interbank borrowing against Ratio 2 liabilities."""
    month = report_date.strftime("%m") + "4"
    period = month + report_date.strftime("%y")
    alw = frames[f"BNM1.ALW{month}"]
    alw = alw.loc[text_column(alw, "AMTIND").ne("")]
    itcode = text_column(alw, "ITCODE")
    mapped = itcode.map(RATIO3_ALW_ITEMS)
    amounts = alw["AMOUNT"].groupby(mapped).sum().to_dict()

    reverse_repo = itcode.eq("3250001000000Y")
    reverse_repo_deductions = itcode.isin({"3250020000000Y", "3250081000000Y"})
    if (reverse_repo | reverse_repo_deductions).any():
        amounts["C3.05"] = (
            alw.loc[reverse_repo, "AMOUNT"].sum()
            - alw.loc[reverse_repo_deductions, "AMOUNT"].sum()
        )

    w1al = frames[f"BNM1.W1AL{month}"]
    held = text_column(w1al, "SET_ID").eq("F137030NIDH")
    if held.any():
        amounts["C3.06A"] = w1al.loc[held, "AMOUNT"].sum()

    utms = frames[f"EQ1.UTMS{period}"]
    security = text_column(utms, "SECTYPE")
    fiss = text_column(utms, "CUSTFISS")
    customer = text_column(utms, "CUSTNO")
    interbank = domestic_interbank_utms(utms)
    net_amount = utms["CAMTOWNE"] + utms["INTACR"] - utms["UNDISCPR"]
    # Later SAS IF statements can replace the item while retaining the amount.
    utms_items = security.mask(security.notna(), "")
    utms_items.loc[interbank] = "C3.03"
    securities = security.isin({"SDC", "SLD", "SSD", "SZD", "LDC"})
    utms_items.loc[securities & fiss.eq("17")] = "C3.06B"
    for item, customers in (
        ("C3.06C", {"BKPKSM", "ISME"}),
        ("C3.06D", {"BKRAK"}),
        ("C3.06E", {"IBSN", "BSN"}),
        ("C3.06F", {"BPMB", "IBPMB"}),
    ):
        utms_items.loc[securities & fiss.eq("33") & customer.isin(customers)] = item
    net_amount = net_amount.mask(interbank & net_amount.notna(), utms["CAMTOWNE"])
    amounts.update(net_amount.groupby(utms_items.where(utms_items.ne(""))).sum().to_dict())

    for prefix in ("C3.01", "C3.04"):
        amounts[prefix] = sas_sum([value for item, value in amounts.items() if item.startswith(prefix)])
    nids_deductions = sas_sum([amounts.get(f"C3.06{suffix}") for suffix in "BCDEF"])
    gross_nids = amounts.get("C3.06A")
    amounts["C3.06"] = (
        None if gross_nids is None and nids_deductions is None
        else (gross_nids or 0) - (nids_deductions or 0)
    )

    borrowing = sas_sum([macro_amount(amounts.get(f"C3.0{index}")) for index in range(1, 4)])
    placement = sas_sum([macro_amount(amounts.get(f"C3.0{index}")) for index in range(4, 7)])
    net_borrowing = difference(borrowing, placement)
    ratio2_amounts = {item: amount for _, item, _, amount in ratio2_rows}
    for index in range(7, 10):
        amounts[f"C3.0{index}"] = macro_amount(ratio2_amounts[f"C2.{index + 2:02}"])
    liabilities = sas_sum([amounts[f"C3.0{index}"] for index in range(7, 10)])

    rows = []
    for item, label in RATIO3_LAYOUT:
        prefix = item[:5]
        if prefix <= "C3.03":
            group = "NET DOMESTIC INTERBANK BORROWING(ACCEPTANCE)"
        elif prefix <= "C3.06":
            group = "LESS"
        else:
            group = "TOTAL DOMESTIC DEPOSIT LIABILITIES"
        rows.append((group, item, label, amounts.get(item)))
        if item == "C3.03":
            rows.append((group, "SUB-TOTAL", "", macro_amount(borrowing)))
        elif item == "C3.06F":
            rows.extend([
                (group, "SUB-TOTAL", "", macro_amount(placement)),
                (group, "TOTAL", "", macro_amount(net_borrowing)),
            ])
        elif item == "C3.09":
            rows.append((group, "SUB-TOTAL", "", macro_amount(liabilities)))
    rows.append(("RATIO", rate_percentage(net_borrowing, liabilities), "", None))
    return rows




def ratio4(report_date, frames):
    """Calculate net overnight acceptance over adjusted gross acceptance."""
    month = report_date.strftime("%m") + "4"
    period = month + report_date.strftime("%y")
    kapiti = frames[f"BNMK.K1TBL{month}"]
    currency = text_column(kapiti, "GWCCY")
    customer_type = text_column(kapiti, "GWCTP")
    eligible = (
        (currency.eq("MYR") | text_column(kapiti, "GWCNAL").eq("MY"))
        & customer_type.isin({"BB", "BC", "BI", "BJ", "BM"})
        & text_column(kapiti, "GWMVT").eq("P")
        & text_column(kapiti, "GWMVTS").eq("M")
    )
    deal = text_column(kapiti, "GWDLP")
    borrow = eligible & deal.eq("BO") & ~text_column(kapiti, "GWSHN").str.startswith("FCY-FD")
    place = eligible & deal.eq("LO")

    alw = frames[f"BNM1.ALW{month}"]
    alw = alw.loc[text_column(alw, "AMTIND").ne("")]
    by_code = alw["AMOUNT"].groupby(text_column(alw, "ITCODE")).sum().to_dict()
    amounts = {}
    # One ALW code can contribute to both overnight and gross borrowing.
    for item, codes in RATIO4_ALW_ITEMS:
        amounts[item] = sas_sum([by_code.get(code) for code in codes])
    if borrow.any():
        amounts["C4.01A"] = kapiti.loc[borrow, "GWBALC"].sum()
    if place.any():
        amounts["C4.02A"] = kapiti.loc[place, "GWBALC"].abs().sum()

    utms = frames[f"EQ1.UTMS{period}"]
    nids = domestic_interbank_utms(utms)
    if nids.any():
        amounts["C4.05"] = utms.loc[nids, "CAMTOWNE"].sum()
    for prefix in ("C4.01", "C4.02", "C4.03"):
        amounts[prefix] = sas_sum([value for item, value in amounts.items() if item.startswith(prefix)])

    overnight_placement = macro_amount(amounts["C4.02"])
    amounts["C4.06"] = overnight_placement
    net_overnight = difference(macro_amount(amounts["C4.01"]), overnight_placement)
    gross = sas_sum([macro_amount(amounts.get(item)) for item in ("C4.03", "C4.04", "C4.05")])
    adjusted_gross = difference(gross, overnight_placement)

    overnight_group = "TOTAL NET OVERNIGHT ACCEPTANCE"
    gross_group = (
        "TOTAL GROSS DOMESTIC INTERBANK BORROWING (ACCEPTANCE) "
        "LESS OVERNIGHT DOMESTIC INTERBANK PLACEMENT"
    )
    rows = []
    for item, label in RATIO4_LAYOUT:
        if item[:5] <= "C4.02":
            group = overnight_group
        elif item[:5] <= "C4.05":
            group = gross_group
        else:
            group = "LESS"
        rows.append((group, item, label, amounts.get(item)))
        if item == "C4.02F":
            rows.append((group, "SUB-TOTAL", "", macro_amount(net_overnight)))
        elif item == "C4.05":
            rows.append((group, "SUB-TOTAL", "", macro_amount(gross)))
        elif item == "C4.06":
            rows.append((group, "TOTAL", "", macro_amount(adjusted_gross)))
    rows.append(("RATIO", rate_percentage(net_overnight, adjusted_gross), "", None))
    return rows


def ratio5(report_date, frames, ratio1_rows, ratio2_rows):
    """Calculate short-term domestic borrowing over short-term domestic funding."""
    month = report_date.strftime("%m") + "4"
    period = month + report_date.strftime("%y")
    epoch = date(1960, 1, 1)
    report_day = (report_date - epoch).days
    next_month = report_date + timedelta(days=1)
    cutoff = (date(next_month.year, next_month.month,
                   monthrange(next_month.year, next_month.month)[1]) - epoch).days

    alw = frames[f"BNM1.ALW{month}"]
    alw = alw.loc[text_column(alw, "AMTIND").ne("")]
    by_code = alw["AMOUNT"].groupby(text_column(alw, "ITCODE")).sum().to_dict()
    amounts = {item: sas_sum([by_code.get(code) for code in codes])
               for item, codes in RATIO5_ALW_ITEMS}

    def add(item, values):
        if not values.empty:
            amounts[item] = (amounts.get(item) or 0) + values.sum()

    bank_types = {"BB", "BC", "BI", "BJ", "BM"}
    repo_banks = bank_types | {"BP"}
    repo_types = repo_banks | set(
        "AD BF BH BR BS BT BU BV BZ AC CA CB CC CD CF CG DD DA DB DC EC EJ FA".split()
    )

    k1 = frames[f"BNMK.K1TBL{month}"]
    deal = text_column(k1, "GWDLP")
    ctp = text_column(k1, "GWCTP")
    currency = text_column(k1, "GWCCY")
    malaysian = text_column(k1, "GWCNAL").eq("MY")
    short = k1["GWMDT"].le(cutoff)
    movement = text_column(k1, "GWMVT").eq("P") & text_column(k1, "GWMVTS").eq("M")
    borrowing = (
        short & movement & deal.isin({"BO", "BF"}) & ctp.isin(bank_types)
        & ~text_column(k1, "GWSHN").str.startswith("FCY-FD")
    )
    add("C5.01A", k1.loc[borrowing & (currency.eq("MYR") | malaysian), "GWBALC"])
    add("C5.07A", k1.loc[borrowing & malaysian, "GWBALC"])
    nids = (
        short & deal.isin({"BCD", "BCI", "BCQ"})
        & ~text_column(k1, "GWC2R").between("82", "99")
        & ~ctp.isin({"EB", "BA", "CE", "BE", "GA", "BW"})
    )
    add("C5.04Z", k1.loc[nids, "GWBALC"])
    repo = short & movement & currency.eq("MYR") & deal.str.slice(1, 3).isin({"MI", "MT"})
    add("C5.02", k1.loc[repo & ctp.isin(repo_banks), "GWBALC"])
    add("C5.05", k1.loc[repo & ctp.isin(repo_types), "GWBALC"])

    k3 = frames[f"BNMK.K3TBL{month}"]
    eligible = (
        k3["MATDT"].le(cutoff)
        & text_column(k3, "UTREF").isin({"PFD", "PLD", "PSD", "PZD"})
        & text_column(k3, "UTSTY").isin({"IFD", "ILD", "ISD", "IZD", "IZP"})
    )
    k3_type = text_column(k3, "UTCTP")
    k3_amount = k3["UTAMOC"] - k3["UTDPF"]
    add("C5.03", k3_amount.loc[eligible & k3_type.isin(bank_types)])
    add("C5.06", k3_amount.loc[eligible & ~k3_type.isin({"BA", "BE", "BW", "CE", "EB", "GA"})])

    utrp = frames[f"EQ1.UTRP{period}"]
    repo = (
        utrp["REPOMATD"].le(cutoff)
        & text_column(utrp, "DEALTYPE").str.slice(1, 3).isin({"RA", "RB", "RQ"})
        & text_column(utrp, "CURRENCY").eq("MYR")
    )
    ctp = text_column(utrp, "CUSTEQTP")
    add("C5.02", utrp.loc[repo & ctp.isin(repo_banks), "TSALPROC"])
    add("C5.05", utrp.loc[repo & ctp.isin(repo_types), "TSALPROC"])

    sip = frames[f"SIP.SIPCERT{period}"]
    maturity = sip["MATDT"].mask(text_column(sip, "PRODKEY").eq("FD20401"),
                               (date(2014, 7, 31) - epoch).days)
    eligible = ~sip["INVSTAT"].isin({601, "601"}) & (maturity.isna() | maturity.le(cutoff))
    sip_amount = sip["PRINAMT"] - sip["REDAMT"]
    add("C5.04J", sip_amount.loc[eligible])
    add("C5.04K", sip_amount.loc[eligible & sip["CUSTCODE"].between(80, 99)])

    dci = frames[f"DCI.DCI{month}"]
    maturity, start = dci["MATDT"], dci["STARTDT"]
    eligible = (maturity.isna() | maturity.le(cutoff)) & (start.isna() | start.le(report_day))
    currency = text_column(dci, "INVCURR")
    nonresident = dci["CUSTCODE"].between(80, 99)
    local = eligible & currency.eq("MYR")
    foreign = eligible & currency.ne("MYR")
    add("C5.04L", dci.loc[local, "INVAMT"])
    add("C5.04M", dci.loc[local & nonresident, "INVAMT"])
    rates = frames["FORATE.FORATEBKP"]
    rates = rates.loc[rates["REPTDATE"].isna() | rates["REPTDATE"].le(report_day)]
    rates = rates.sort_values("REPTDATE", ascending=False, kind="stable", na_position="last")
    rates = rates.assign(CURCODE=text_column(rates, "CURCODE"))
    spot = rates.drop_duplicates("CURCODE").set_index("CURCODE")["SPOTRATE"]
    converted = dci["INVAMT"] * currency.map(spot)
    add("C5.04V", converted.loc[foreign])
    add("C5.04W", converted.loc[foreign & nonresident])

    previous = {item: amount for _, item, _, amount in [*ratio1_rows, *ratio2_rows]}
    for suffix, item in RATIO5_DEPOSIT_ITEMS.items():
        amounts[f"C5.04{suffix}"] = macro_amount(previous[item])

    for suffix in "JKLMVW":
        amounts[f"C5.04{suffix}"] = 0.0
    deposits = sum(amounts.get(f"C5.04{suffix}") or 0 for suffix in "ACEFHJLNPRTVXZ")
    deductions = sum(amounts.get(f"C5.04{suffix}") or 0 for suffix in "BDGIKMOQSUWY")
    amounts["C5.04"] = deposits - deductions
    for prefix in ("C5.01", "C5.07"):
        amounts[prefix] = sas_sum([value for item, value in amounts.items() if item.startswith(prefix)])
    borrowing = sas_sum([macro_amount(amounts.get(item)) for item in ("C5.01", "C5.02", "C5.03")])
    funding = sas_sum([macro_amount(amounts.get(item)) for item in ("C5.04", "C5.05", "C5.06", "C5.07")])

    rows = []
    for item, label in RATIO5_LAYOUT:
        group = ("SHORT TERM GROSS DOMESTIC INTERBANK BORROWING (ACCEPTANCE)"
                 if item[:5] <= "C5.03" else "SHORT TERM DOMESTIC TOTAL FUNDING")
        rows.append((group, item, label, amounts.get(item)))
        if item == "C5.03":
            rows.append((group, "SUB-TOTAL", "", macro_amount(borrowing)))
    rows.append(("SHORT TERM DOMESTIC TOTAL FUNDING", "SUB-TOTAL", "", macro_amount(funding)))
    rows.append(("RATIO", rate_percentage(borrowing, funding), "", None))
    return rows


def report_lines(report_date, title, rows):
    lines = [
        "REPORT ID : EIBMLIQ3",
        f"DATE : {report_date:%d/%m/%y}",
        "PART 3",
        "CONCENTRATION OF FUNDING SOURCES (PBB)",
        title,
        "",
        f"{'ITEM':<18} {'DESCRIPTION':<60} {'MONTH END':>19}",
    ]
    previous_group = None
    for group, item, label, amount in rows:
        if group != previous_group:
            lines.append(f"{group}:")
            previous_group = group
        formatted = "" if group == "RATIO" else f"{0 if amount is None else amount:,.2f}"
        lines.append(f"{item:<18} {label:<60} {formatted:>19}".rstrip())
    return lines


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run-date", type=date.fromisoformat)
    parser.add_argument("--output-dir", type=Path, default=Path("."))
    args = parser.parse_args()
    members = {
        "BNMK.K1TBL", "BNMK.K3TBL", "EQ1.UTRP", "DCI.DCI", "BNM1.ALW", "BNM1.W1AL", "EQ1.UTMS", "EQ1.UTFX", "FD.FD", "FCY.FCY",
        "CIS.CISR1FD", "CIS.CISR1CA", "CA.CA", "SIP.SIPCERT", "FORATE.FORATEBKP",
    }
    report_date, frames = load_inputs(args.run_date, members=members)
    first_rows = ratio1(report_date, frames)
    second_rows = ratio2(report_date, frames, first_rows)
    sections = (
        ("RATIO 1: ADJUSTED LOAN / DEPOSIT RATIO", first_rows),
        ("RATIO 2: NET OFFSHORE BORROWING (ACCEPTANCE) / TOTAL DOMESTIC DEPOSIT LIABILITIES",
         second_rows),
        ("RATIO 3: NET DOMESTIC INTERBANK BORROWING (ACCEPTANCE) / TOTAL DOMESTIC DEPOSIT LIABILITIES",
         ratio3(report_date, frames, second_rows)),
        ("RATIO 4: TOTAL NET DOMESTIC OVERNIGHT INTERBANK BORROWING (ACCEPTANCE) / "
         "TOTAL GROSS DOMESTIC INTERBANK ACCEPTANCE LESS OVERNIGHT DOMESTIC INTERBANK LENDING",
         ratio4(report_date, frames)),
        ("RATIO 5: SHORT TERM GROSS DOMESTIC INTERBANK BORROWING (ACCEPTANCE) / "
         "SHORT TERM DOMESTIC TOTAL FUNDING", ratio5(report_date, frames, first_rows, second_rows)),
    )
    report = "\n\n".join("\n".join(report_lines(report_date, title, rows)) for title, rows in sections)
    args.output_dir.mkdir(parents=True, exist_ok=True)
    (args.output_dir / "EIBMLIQ3.txt").write_text(report + "\n", encoding="utf-8")


