PROC SORT DATA=DATAMART.INCEFD&TYPE&DATANAME OUT=INCEFD_AMT; BY  REPTDATE; RUN;

DATA INCAMT&TYPE (KEEP=REPTDATE TOT&TYPE._AMT TOT&TYPE._ACCT DLYINC&TYPE._ACCT DLYINC&TYPE._AMT DLYAVG&TYPE._ACCT DLYAVG&TYPE._AMT);
   	MERGE XSUMFD&TYPE(IN=A) INCEFD_AMT(IN=B) AVGEFD_AMT;
   BY REPTDATE;
   IF A AND B;

	MTHDTE = MONTH(REPTDATE);
	YRDTE  = YEAR(REPTDATE);

	IF &CAM_DAY NE 1 AND MTHDTE = &CAM_MTH AND YRDTE = &CAM_YR THEN DO;
		   DAY = (&REPTDT - &CAMPAIGN_STDT)+1;
	END;
	ELSE DO;
	       DAY = &REPTDAY;
	END;

	DLYAVG&TYPE._ACCT = SUM(TOT&TYPE._ACCT,(-1)*AVG&TYPE._ACCT)/DAY;;
	DLYAVG&TYPE._AMT  = SUM(TOT&TYPE._AMT,(-1)*AVG&TYPE._AMT)/DAY;	   

	IF  &REPTDT = &CAMPAIGN_STDT THEN DO;
		DLYINC&TYPE._ACCT = TOT&TYPE._ACCT;
		DLYINC&TYPE._AMT  = TOT&TYPE._AMT;

    END;
	ELSE DO;
		DLYINC&TYPE._ACCT = SUM(TOT&TYPE._ACCT,(-1)*MTH&TYPE._ACCT);
		DLYINC&TYPE._AMT  = SUM(TOT&TYPE._AMT,(-1)*MTH&TYPE._AMT);  
	END;
RUN;

