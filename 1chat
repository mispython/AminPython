DATA UNDRAWNOUT STAFF;
   SET UNDRAWNOUT;
   LENGTH COSTCTR_C $7.;
   ANALYCD  ='ACTUAL';
   IF SOURCE = 'IBILL' THEN GLACCD = 'RWA_CR_OFFBS_LNA_IBILLS';
   ELSE IF SOURCE = 'UBILL' THEN GLACCD = 'RWA_CR_OFFBS_LNA_UBILLS';
   ELSE IF SOURCE = 'ULOAN' THEN GLACCD = 'RWA_CR_OFFBS_LNA_ULOAN';
   ELSE IF SOURCE = 'ELDS' THEN GLACCD = 'RWA_CR_OFFBS_LNA_ELDS'; 
   ELSE GLACCD = 'RWA_CR_OFFBS_LNA_CARD'; 
   SIGN='+';
   LDAY=("&LDAY")*1;
   IF LENGTH(COSTCENTER)=3 THEN COSTCTR_C='0'||COSTCENTER;
   ELSE COSTCTR_C=COSTCENTER;
