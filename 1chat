 DATA REPTDATE;   
   REPTDATE=&SAS_DT_SASDLY -DAY(&SAS_DT_SASDLY );
 
   CALL SYMPUT('RYEAR',PUT(REPTDATE,YEAR2.));
   CALL SYMPUT('REPTYEAR',PUT(REPTDATE,YEAR2.)); 
   CALL SYMPUT('REPTYEA1',PUT(REPTDATE,YEAR4.));    
   CALL SYMPUT('REPTMON1',PUT(MONTH(REPTDATE),Z2.));
   CALL SYMPUT('REPTDATE',REPTDATE);
   CALL SYMPUT('NOWK', PUT('4', $1.)); 
RUN;  

DATA BASEL3_EXPOSURE_FINAL;
   SET basel.BASEL3_EXPOSURE_FINAL_&ryear&reptmon1; 
   FORMAT SOURCE $32.;
   WHERE D_BANK_ENTITY = 'PBBH' AND D_SOURCE_CATEGORY IN ('LNMART','UNDRAWN LN','UNDRAWN ULOAN','UNDRAWN MANUAL',
   'UNDISBURSED','UNDISBURSED FS','UNDISBURSED MANUAL','UNDRAWN BILLS','IBILL OS','UNDRAWN CARD')
   AND D_PROD_GROUP_KONGLOMERAT_BNM NOT IN ('New','NEW','new');
   PRODUCT = SYS_PRODUCT * 1;
   IF D_SOURCE_CATEGORY IN ('LNMART','UNDRAWN CARD') THEN SOURCE = 'E';
   ELSE IF D_SOURCE_CATEGORY IN ('UNDRAWN LN','UNDRAWN ULOAN','UNDRAWN MANUAL') THEN SOURCE = 'ULOAN';
   ELSE IF D_SOURCE_CATEGORY IN ('UNDISBURSED','UNDISBURSED FS','UNDISBURSED MANUAL') THEN SOURCE = 'ELDS';
   ELSE IF D_SOURCE_CATEGORY IN ('UNDRAWN BILLS') THEN SOURCE = 'UBILL';
   ELSE IF D_SOURCE_CATEGORY IN ('IBILL OS') THEN SOURCE = 'IBILL';
   KEEP SOURCE D_BANK_ENTITY D_SOURCE_CATEGORY D_PROD_GROUP_KONGLOMERAT_BNM D_PRODUCT_TYPE M_RW_ASSET SYS_PRODUCT BRANCH
        MASTACC NOTENO D_EXPOSURE_TYPE PRODUCT M_TOTAL_ON_OFF_BAL;
RUN;

PROC SORT DATA=BASEL3_EXPOSURE_FINAL; BY PRODUCT;RUN;
PROC SORT DATA=APPL.APP1 OUT=APP1 NODUPKEY;BY PRODUCT;RUN;

DATA BASEL3_EXPOSURE_FINAL;
   MERGE BASEL3_EXPOSURE_FINAL(IN=A) APP1(IN=B);BY PRODUCT;
   IF A;
RUN;

PROC SORT DATA=BASEL3_EXPOSURE_FINAL;BY BRANCH;RUN;

DATA APP3(KEEP=BRANCH1 CCC RENAME=BRANCH1=BRANCH );
   SET EGS.keep_undrawn_ln_ftp_app3_br;
   BRANCH1 = BRANCH * 1;
RUN;
PROC SORT DATA=APP3;BY BRANCH;RUN;

DATA BASEL3_EXPOSURE_FINAL;
   MERGE BASEL3_EXPOSURE_FINAL(IN=A) APP3(IN=B);BY BRANCH;
   FORMAT COSTCENTER $10.;
   IF A;
   IF BRANCH = 902 THEN DO;
      IF D_PRODUCT_TYPE NE 'RM STAFF LOANS' THEN CCC = '8651'; 
   END; 
   IF CCC NE ' ' THEN COSTCENTER = CCC;
   ELSE COSTCENTER = PUT(BRANCH, Z3.);
RUN;

DATA HP_LNA BASEL3_2;
   SET BASEL3_EXPOSURE_FINAL;
   IF D_SOURCE_CATEGORY NOT IN ('UNDRAWN BILLS','IBILL_OS','UNDRAWN CARD') AND 
   D_PROD_GROUP_KONGLOMERAT_BNM IN ('HirePurchase','CommercialRetailLoans') AND
   D_PRODUCT_TYPE IN ('HIRE PURCHASE RECEIVABLE','RM FLOOR STOCKING LOANS') THEN OUTPUT HP_LNA;
   ELSE OUTPUT BASEL3_2;
RUN;

DATA RETL_LNA RETL_LNA_MAPOD BASEL3_3;
   SET BASEL3_2;
   IF D_SOURCE_CATEGORY NOT IN ('UNDRAWN CARD') AND D_PROD_GROUP_KONGLOMERAT_BNM NOT IN ('CorporateBankingLoans','HirePurchase','StaffLoans','CreditCard') THEN DO;
      IF D_PRODUCT_TYPE IN ('BILLS') THEN DO;
         FM_PROD = 'LTF_OT';
	     FM_LOB = 'RETL';
      END;
      IF D_SOURCE_CATEGORY IN ('UNDRAWN BILLS','IBILL_OS') AND D_PRODUCT_TYPE NE 'BILLS' THEN DELETE;
      IF D_PRODUCT_TYPE IN ('RM OVERDRAFT LOANS','RM SHARE FINANCING') THEN OUTPUT RETL_LNA_MAPOD;
      ELSE OUTPUT RETL_LNA;
   END;
   ELSE OUTPUT BASEL3_3;
RUN;

DATA CORP_LNA CORP_LNA_MAPOD BASEL3_4;
   SET BASEL3_3; 
   IF D_SOURCE_CATEGORY NOT IN ('UNDRAWN CARD') AND D_PROD_GROUP_KONGLOMERAT_BNM = 'CorporateBankingLoans' THEN DO;
      IF D_PRODUCT_TYPE IN ('BILLS') THEN DO;
         FM_PROD = 'LTF_OT';
	     FM_LOB = 'CORP';
      END;
      IF D_SOURCE_CATEGORY IN ('LNMART') THEN DO;
         IF FIND(D_PRODUCT_TYPE, 'FX', 'i') > 0 THEN COSTCENTER = '8650_564';
      END;
      ELSE IF D_SOURCE_CATEGORY IN ('UNDISBURSED','UNDISBURSED FS','UNDISBURSED MANUAL') THEN COSTCENTER = '8651';
      IF D_SOURCE_CATEGORY IN ('UNDRAWN BILLS','IBILL_OS') AND D_PRODUCT_TYPE NE 'BILLS' THEN DELETE;
      IF D_PRODUCT_TYPE IN ('RM OVERDRAFT LOANS','RM SHARE FINANCING') THEN OUTPUT CORP_LNA_MAPOD;
      ELSE OUTPUT CORP_LNA;
   END;
   ELSE OUTPUT BASEL3_4;
RUN;


DATA CARD_LNA BASEL3_5;
   SET BASEL3_4;
   IF D_SOURCE_CATEGORY IN ('LNMART','UNDRAWN CARD') AND D_PROD_GROUP_KONGLOMERAT_BNM = 'CreditCard' 
   AND D_PRODUCT_TYPE = 'RM CREDIT CARD LOAN' THEN DO;
      COSTCENTER = '7400_720';
      FM_PROD = 'LCARDS';
      FM_LOB = 'CARD';
	  OUTPUT CARD_LNA;
   END;
   ELSE OUTPUT BASEL3_5;
RUN;

DATA STAFF_LNA;
   SET BASEL3_5;
   IF D_SOURCE_CATEGORY NOT IN ('UNDRAWN BILLS','IBILL_OS','UNDRAWN CARD') AND 
   D_PROD_GROUP_KONGLOMERAT_BNM IN ('StaffLoans') AND D_PRODUCT_TYPE = 'RM STAFF LOANS' THEN OUTPUT STAFF_LNA;
RUN;

DATA CORP_RETL_OD(DROP=FM_PROD FM_LOB);
   SET CORP_LNA_MAPOD RETL_LNA_MAPOD;  
RUN;

