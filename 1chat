   IF SOURCE IN ('IBILL','UBILL','ULOAN','ELDS');
   IF ('3000000000'<=MASTACC<='3999999999') THEN OUTPUT UNDRAWN_OD;
   ELSE IF D_SOURCE_CATEGORY IN ('IBILL OS','UNDRAWN BILLS') AND D_PRODUCT_TYPE = 'BILLS' THEN OUTPUT UNDRAWN_BILL;
   ELSE OUTPUT UNDRAWN_LN;
RUN;

