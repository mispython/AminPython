/* GENERATE NEW INTERFACES TO GL ON TRANSFER PRICING ON UNDRAWN IN PBBH AND PIBB */

FILENAME OUTFTP '/stgsrcsys/host/ftpfiles'; 

DATA REPTDATE;
    TODAY = &SAS_DT_SASDLY;
	DATENOW  = PUT(YEAR(TODAY),Z4.)||PUT(MONTH(TODAY),Z2.)||PUT(25,Z2.);  
	TIMENOW  = PUT(HOUR(TIME()),Z2.)||PUT(MINUTE(TIME()),Z2.)||PUT(SECOND(TIME()),Z2.); 
	REPTDATE = MDY(MONTH(TODAY),25,YEAR(TODAY)); 
	MONTHEND = MDY(MONTH(TODAY),1,YEAR(TODAY))-1;
	CALL SYMPUT('CRDATE',PUT(DATENOW,8.)); 
	CALL SYMPUT('CRTIME',PUT(TIMENOW,6.));
	CALL SYMPUT('REPTYEAR',PUT(REPTDATE,YEAR4.));
	CALL SYMPUT('REPTMON',PUT(MONTH(REPTDATE),Z2.));
	CALL SYMPUT('REPTDAY',PUT(DAY(REPTDATE),Z2.));
	CALL SYMPUT('REPTYY',PUT(REPTDATE,YEAR2.));
	CALL SYMPUT('REPTDATE',PUT(REPTDATE,YYMMDDN.));
	CALL SYMPUT('NEXTDATE',PUT(NEXTDATE,YYMMDDN.));
	CALL SYMPUT('MONNAME',UPCASE(PUT(REPTDATE,MONNAME3.)));	
	CALL SYMPUT('LMONTH',PUT(MONTH(MONTHEND),Z2.));
	CALL SYMPUT('LDAY',PUT(DAY(MONTHEND),Z2.));
	CALL SYMPUT('LYEAR',PUT(MONTHEND,YEAR4.));
	CALL SYMPUT('RDATE',PUT(REPTDATE,DDMMYY10.));  
	FORMAT REPTDATE DDMMYY10.;
RUN;

