   IF FM_PROD='LSTAFF' THEN DO;
      FM_LOB='RETL';
	  GL_ACCTNO='92180';
	  GL_PROD_PBB='3900';
      OUTPUT STAFF;
   END;
   ELSE OUTPUT UNDRAWNOUT;
RUN;

