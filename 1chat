libname cirsrc "/stgsrcys";
libname cirout "/host1";

%macro update_cir_close;

    %local current_mmyyyy source start_year end_year yr;

    /* Source automatik ikut bulan dan tahun semasa */
    %let current_mmyyyy = %sysfunc(today(),mmyyn6.);
    %let source = cirsrc.CIR_CLOSE_&current_mmyyyy;

    /* Semak source wujud */
    %if not %sysfunc(exist(&source)) %then %do;
        %put ERROR: Source &source tidak wujud.;
        %return;
    %end;

    /* APPROVE_DATE mesti numeric SAS datetime */
    %let start_year = .;
    %let end_year = .;

    proc sql noprint;
        select min(year(datepart(APPROVE_DATE))),
               max(year(datepart(APPROVE_DATE)))
        into :start_year trimmed, :end_year trimmed
        from &source
        where not missing(APPROVE_DATE)
          and APPROVE_DATE >= '01JAN2024:00:00:00'dt;
    quit;

    %if &start_year = . or &end_year = . %then %do;
        %put NOTE: Tiada rekod yang layak diproses dalam &source.;
        %return;
    %end;

    %do yr = &start_year %to &end_year;

        /* Asingkan rekod mengikut tahun APPROVE_DATE */
        data work.cir_year;
            set &source;

            if missing(APPROVE_DATE) then delete;
            if APPROVE_DATE >= '01JAN2024:00:00:00'dt;
            if year(datepart(APPROVE_DATE)) = &yr;
        run;

        /* Append jika dataset tahunan sudah wujud */
        %if %sysfunc(exist(cirout.CIR_CLOSE_&yr)) %then %do;

            proc append
                base=cirout.CIR_CLOSE_&yr
                data=work.cir_year;
            run;

        %end;
        %else %do;

            data cirout.CIR_CLOSE_&yr;
                set work.cir_year;
            run;

        %end;

        /* Buang duplicate hanya jika SEMUA field sama */
        proc sort data=cirout.CIR_CLOSE_&yr nodupkey;
            by _all_;
        run;

    %end;

    /* Bersihkan temporary dataset */
    proc datasets library=work nolist;
        delete cir_year;
    quit;

%mend update_cir_close;

%update_cir_close;
