PROC SORT DATA=HAVE;
    BY ACCTNO SECUST;
RUN;

DATA WANT;
    SET HAVE;
    BY ACCTNO;

    RETAIN SELECTED;

    IF FIRST.ACCTNO THEN SELECTED = 0;

    IF SELECTED = 0 THEN DO;

        IF SECUST = '901' AND
           7 <= AGE <= 17 THEN DO;
            OUTPUT;
            SELECTED = 1;
        END;

        ELSE IF SECUST = '902' AND
                7 <= AGE <= 17 THEN DO;
            OUTPUT;
            SELECTED = 1;
        END;

    END;

    DROP SELECTED;
RUN;




proc sort data=HAVE;
    by ACCTNO;
run;

data WANT;
    set HAVE;
    by ACCTNO;

    retain PRIMARY_AGE SECONDARY_AGE;

    if first.ACCTNO then do;
        PRIMARY_AGE = .;
        SECONDARY_AGE = .;
    end;

    if SECUST = '901' then
        PRIMARY_AGE = AGE;
    else if SECUST = '902' then
        SECONDARY_AGE = AGE;

    if last.ACCTNO then do;

        if 7 <= PRIMARY_AGE <= 17 then do;
            SECUST = '901';
            AGE = PRIMARY_AGE;
            output;
        end;

        else if 7 <= SECONDARY_AGE <= 17 then do;
            SECUST = '902';
            AGE = SECONDARY_AGE;
            output;
        end;

    end;

    keep ACCTNO SECUST AGE;
run;
proc sort data=HAVE;
    by ACCTNO;
run;

data WANT;
    set HAVE;
    by ACCTNO;

    retain PRIMARY_AGE PRIMARY_FOUND
           SECONDARY_AGE SECONDARY_FOUND;

    if first.ACCTNO then do;
        PRIMARY_AGE = .;
        SECONDARY_AGE = .;
        PRIMARY_FOUND = 0;
        SECONDARY_FOUND = 0;
    end;

    if SECUST = '901' then do;
        PRIMARY_AGE = AGE;
        PRIMARY_FOUND = 1;
    end;
    else if SECUST = '902' then do;
        SECONDARY_AGE = AGE;
        SECONDARY_FOUND = 1;
    end;

    if last.ACCTNO then do;

        if PRIMARY_FOUND = 1
           and 7 <= PRIMARY_AGE <= 17 then do;
            SECUST = '901';
            AGE = PRIMARY_AGE;
            output;
        end;

        else if SECONDARY_FOUND = 1
                and 7 <= SECONDARY_AGE <= 17 then do;
            SECUST = '902';
            AGE = SECONDARY_AGE;
            output;
        end;

    end;

    keep ACCTNO SECUST AGE;
run;
