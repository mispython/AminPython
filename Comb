      9-10    = '>9  MTHS - 10 MTHS'                                            
      10-11   = '>10 MTHS - 11 MTHS'                                            
      11-12   = '>11 MTHS - 12 MTHS'                                            
      12-24   = '>1  YR - 2 YRS'                                                
      24-36   = '>2  YRS - 3 YRS'                                               
      36-48   = '>3  YRS - 4 YRS'                                               
