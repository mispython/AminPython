   VAR AMOUNT YIELD;                                                            
   OUTPUT OUT=NOTE (DROP=_TYPE_ _FREQ_) SUM=;                                   
*;                                                                              
DATA NOTE;                                                                      
   SET NOTE;                                                                    
   IF SUBTYP NOT IN (7,8) THEN                                                  
      WAYLD = YIELD / AMOUNT;                                                   
   AMOUNT = ROUND(AMOUNT/1000);                                                 
