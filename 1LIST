/************************************************************/
/** MACRO TO COMPUTE THE TOTAL ELIGIBLE LIABILITIES        **/
/** FOR DAY A - DAY H                                      **/
/************************************************************/

%MACRO EL(I);
PROC DATASETS LIB=WORK NOLIST;
  DELETE TOTALEL ELSRR ELW;
RUN;

DATA ELW;
  SET BNM.ELW&REPTMON&NOWK;
  IF ELDAY="&I";
