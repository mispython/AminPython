DATA ALM ALMBT;
 KEEP ACCTNO NOTENO FISSPURP PRODUCT NOTETERM EARNTERM BALANCE PAIDIND
      APPRDATE APPRLIM2 PRODCD CUSTCD AMTIND SECTORCD ACCTYPE BRANCH
      ORIBAL DNBFISME NOACCT COMMNO;
 MERGE LOAN(IN=A RENAME=(BALANCE=ORIBAL BAL_AFT_EIR=BALANCE))
       LNCOMM(IN=B);
   BY ACCTNO COMMNO;
   IF A;
   IF PAIDIND NOT IN ('P','C') OR EIR_ADJ NE .;
    *  IF ACCTYPE='OD' AND PRODUCT IN (150,151,152,181) THEN DELETE;
      FORMAT BALX 4.2;
      XIND=' ';
      IF ORIBAL=-.00             THEN DELETE;
      BALX=ROUND(ORIBAL,.01);
      IF BALX IN (0.00,-0.00)    THEN XIND='Y';
    *  IF PAIDIND IN ('P','C') OR XIND='Y' THEN DELETE;
      IF XIND='Y' THEN DELETE;
      IF SUBSTR(PRODCD,1,2) = '34' OR PRODCD = '54120';
   IF ACCTYPE='LN' THEN DO;
      /* ONLY AFFECT NOACCT, OTHERS REMAIN */
      IF (RLEASAMT^=0.00 AND PAIDIND NOT IN ('P','C') AND
          ORIBAL>0 AND CJFEE^=ORIBAL) OR
         (RLEASAMT =0.00 AND PAIDIND NOT IN ('P','C') AND
          ORIBAL>0 AND PRODUCT IN (600:699)) OR
         (RLEASAMT =0.00 AND PAIDIND NOT IN ('P','C') AND
          ORIBAL>0 AND COMMNO>0 AND CUSEDAMT>0) THEN /*NOTHING*/;
      ELSE NOACCT=0;
   END;
   IF PAIDIND NOT IN ('P','C') AND NOACCT^=0 AND
      ROUND(ORIBAL,.01) NOT IN (0.00,-0.00) AND ORIBAL NE ' '
      THEN NOACCT= 1;
   IF (2850000000<=ACCTNO<=2859999999 AND 40000<=NOTENO<=49999) OR
       PRODUCT = 444
      THEN OUTPUT ALMBT;ELSE OUTPUT ALM;
RUN;

