   FORMAT PRODESC $35.;
   IF PRODUCT IN (135,136,138,419,420,422,424,426,464,465,468,469,470,
                  441,443,475,477,482,483,490,491,492,493,496,497,498,
                  652,653,668,669,672,673,674,675,693) THEN
