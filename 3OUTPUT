   IF ACCTYPE = 'OD' AND PRODCD IN ('34180','34240') AND
                 PRODUCT IN &ODCORP THEN
      PRODESC = 'OD CORPORATE';   ELSE
   IF ACCTYPE = 'OD' AND PRODCD IN ('34180','34240') AND
                 PRODUCT NOT IN &ODCORP THEN
      PRODESC = 'OD RETAIL';      ELSE
   IF ACCTYPE = 'LN' AND PRODCD NOT IN ('34111','34120','N','M') AND
                 PRODUCT IN &FLCORP THEN
      PRODESC = 'OTHERS CORPORATE';  ELSE
   IF ACCTYPE = 'LN' AND PRODCD NOT IN ('34111','34120','N','M') AND
