   IF ACCTYPE = 'LN' AND PRODCD IN ('34111') OR
                 PRODUCT IN (698,699,983) THEN
      PRODESC = 'HIRE PURCHASE';  ELSE
   IF ACCTYPE = 'LN' AND PRODCD IN ('54120') THEN
      PRODESC = 'HOUSE FINANCING SOLD TO CAGAMAS';  ELSE
   IF ACCTYPE = 'LN' AND PRODCD IN ('34120') OR
                 PRODUCT IN &HLWOF THEN
