  SET DLY_BALBASE;
  DATE = MDY(INPUT(SUBSTR(put(DATEX,4.),1,2),2.),INPUT(SUBSTR(put(DATEX,4.),3,2),2.),&yyyy_sas);
  WHERE PLACE_AMT NOT IN(.,0);
RUN;

