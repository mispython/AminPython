DATA DLY_BALBASE;
   SET BALFDCD;
   LENGTH DATEX $4. PLACE_AMT 8;

   ARRAY DLY{*} &DLY_VARS;

  DO I = 1 TO DIM(DLY);
    PLACE_AMT = DLY[I];
	 DATEX = SUBSTR(VNAME(DLY[I]),9,4);
	 OUTPUT;
  END;
RUN;

