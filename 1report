LIBNAME HOLDOUT '/stgsrcsys/host/holding';

PROC SORT DATA=HOLDOUT.DM_REPO260228X OUT=REPO_OLD;
	BY D_BANK_ENTITY DEALREF;
RUN;

PROC SORT DATA=HOLDOUT.DM_REPO260228 OUT=REPO_NEW;
	BY D_BANK_ENTITY DEALREF;
RUN;

PROC COMPARE BASE=REPO_OLD
             COMPARE=REPO_NEW
             METHOD=EXACT
             OUT=REPO_DIFF
             OUTNOEQUAL
             OUTBASE
             OUTCOMP
             NOPRINT;
	ID D_BANK_ENTITY DEALREF;
RUN;

DATA REPO_BEFORE_AFTER;
	LENGTH VERSION $6;
	SET REPO_DIFF;
	IF _TYPE_ = 'BASE' THEN VERSION = 'BEFORE';
	ELSE IF _TYPE_ = 'COMPARE' THEN VERSION = 'AFTER';
	ELSE DELETE;
	DROP _TYPE_ _OBS_;
RUN;

PROC SORT DATA=REPO_BEFORE_AFTER;
	BY D_BANK_ENTITY DEALREF DESCENDING VERSION;
RUN;

PROC PRINT DATA=REPO_BEFORE_AFTER NOOBS;
	BY D_BANK_ENTITY DEALREF;
	ID VERSION;
	VAR D_CURRENCY_CD D_IDENTIFIER
	    D_PRODUCT_TYPE D_RECON_PROD_TYPE;
	TITLE 'Before and After - Records with Differences';
RUN;
TITLE;
