PROC SQL NOPRINT;
  SELECT NAME INTO : DLY_VARS SEPARATED BY ' '
  FROM DICTIONARY.COLUMNS
  WHERE LIBNAME = 'WORK'
        AND MEMNAME = "BALFDCD"
		AND UPCASE(NAME) LIKE "DLY_BAL_&MM_SAS.%";
