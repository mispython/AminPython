DATA CRMCUM(KEEP=ACCTNO NOTENO CURAVMTH CUBALYTD);
   SET TEMP.CRMCUM_&YYYY_SAS;
   IF "&REPTMON2" EQ "12" THEN CUBAL    = CUBALYTD_&CMMDD;
   ELSE CUBAL    = SUM(CUBALYTD_&CMMDD,(-1)*CUBALYTD_&PMMDD);
   CURAVMTH = CUBAL / &REPTDAY;
   IF CUBALYTD_&CMMDD > 0 THEN CUBALYTD = CUBALYTD_&CMMDD /  DAYYTD;
RUN;
PROC SORT DATA=CRMCUM; BY ACCTNO NOTENO; RUN;


data _null_;
   report_date = &SAS_DT_SAS;
   prev_month_end = intnx('month', report_date, -1, 'end');

   call symputx('REPTMON2', put(month(report_date), z2.), 'G');
   call symputx('CMMDD', put(report_date, mmddyy4.), 'G');
   call symputx('PMMDD', put(prev_month_end, mmddyy4.), 'G');
   call symputx('REPTDAY', day(report_date), 'G');
run;


%INCLUDE '/dwh/ftp/batch/PBBLNFMT.txt';
LIBNAME TEMP '/dwh/dwh_m/tempsource/ln';

DATA CRMCUM(KEEP=ACCTNO NOTENO CURAVMTH CUBALYTD);
   SET TEMP.CRMCUM_&YYYY_SAS;
   IF "&REPTMON2" EQ "12" THEN CUBAL    = CUBALYTD_&CMMDD;
   ELSE CUBAL    = SUM(CUBALYTD_&CMMDD,(-1)*CUBALYTD_&PMMDD);
