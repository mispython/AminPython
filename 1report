LIBNAME HOLDOUT '/stgsrcsys/host/holding';

PROC SORT DATA=HOLDOUT.DM_REPO260228X OUT=REPO_OLD;
	BY D_BANK_ENTITY DEALREF;
RUN;

PROC SORT DATA=HOLDOUT.DM_REPO260228 OUT=REPO_NEW;
	BY D_BANK_ENTITY DEALREF;
RUN;

/* Compare all fields */
PROC COMPARE BASE=REPO_OLD
             COMPARE=REPO_NEW
             METHOD=EXACT
             OUT=REPO_DIFF
             OUTNOEQUAL
             OUTBASE
             OUTCOMP
             NOPRINT;
	ID D_BANK_ENTITY DEALREF;
RUN;

/* Show before and after for records with differences */
DATA REPO_BEFORE_AFTER;
	LENGTH VERSION $6;
	SET REPO_DIFF;
	IF _TYPE_ = 'BASE' THEN VERSION = 'BEFORE';
	ELSE IF _TYPE_ = 'COMPARE' THEN VERSION = 'AFTER';
	ELSE DELETE;
	DROP _TYPE_ _OBS_;
RUN;

PROC SORT DATA=REPO_BEFORE_AFTER;
	BY D_BANK_ENTITY DEALREF DESCENDING VERSION;
RUN;

PROC PRINT DATA=REPO_BEFORE_AFTER NOOBS;
	BY D_BANK_ENTITY DEALREF;
	ID VERSION;
	VAR D_CURRENCY_CD D_IDENTIFIER
	    D_PRODUCT_TYPE D_RECON_PROD_TYPE;
	TITLE 'Before and After - Records with Differences';
RUN;
TITLE;

/* Validate ALL new REPO records against the requirement */
DATA REPO_VALIDATION;
	LENGTH EXPECTED_VALUE $50 CHECK_RESULT $6;
	SET REPO_NEW;
	WHERE D_IDENTIFIER = 'REPO';

	IF D_CURRENCY_CD = 'MYR' THEN
		EXPECTED_VALUE = 'RM REPURCHASE AGREEMENTS';
	ELSE
		EXPECTED_VALUE = 'FX REPURCHASE AGREEMENT';

	IF D_PRODUCT_TYPE = EXPECTED_VALUE AND
	   D_RECON_PROD_TYPE = EXPECTED_VALUE THEN
		CHECK_RESULT = 'PASS';
	ELSE
		CHECK_RESULT = 'FAIL';

	/* Blank currency needs review even though it is not MYR */
	IF MISSING(D_CURRENCY_CD) THEN CHECK_RESULT = 'REVIEW';
RUN;

/* Summary of enhancement results */
PROC FREQ DATA=REPO_VALIDATION;
	TABLES D_CURRENCY_CD*CHECK_RESULT / MISSING NOCOL NOROW NOPERCENT;
	TITLE 'Enhancement Validation - All New REPO Records';
RUN;
TITLE;

/* Show records that do not meet the requirement */
PROC PRINT DATA=REPO_VALIDATION NOOBS;
	WHERE CHECK_RESULT NE 'PASS';
	VAR D_BANK_ENTITY DEALREF D_CURRENCY_CD D_IDENTIFIER
	    D_PRODUCT_TYPE D_RECON_PROD_TYPE
	    EXPECTED_VALUE CHECK_RESULT;
	TITLE 'Enhancement Validation - Failed or Review Records';
RUN;
TITLE;

/* Other fields and record keys should remain unchanged */
PROC COMPARE
	BASE=REPO_OLD(DROP=D_PRODUCT_TYPE D_RECON_PROD_TYPE)
	COMPARE=REPO_NEW(DROP=D_PRODUCT_TYPE D_RECON_PROD_TYPE)
	METHOD=EXACT;
	ID D_BANK_ENTITY DEALREF;
	TITLE 'Other Fields - Expected to Have No Differences';
RUN;
TITLE;

/* Non-REPO records should remain unchanged, including product fields */
PROC COMPARE
	BASE=REPO_OLD(WHERE=(D_IDENTIFIER NE 'REPO'))
	COMPARE=REPO_NEW(WHERE=(D_IDENTIFIER NE 'REPO'))
	METHOD=EXACT;
	ID D_BANK_ENTITY DEALREF;
	TITLE 'Non-REPO Records - Expected to Have No Differences';
RUN;
TITLE;
