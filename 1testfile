/* =========================================================
   TEST REPORT — APRIL 2026
   Simulate run: 01MAY2026

   Output: SAS Results sahaja
   No output dataset, export, or source updates.
   ========================================================= */

/* Library aliases khas untuk testing */
libname ztbal26
    ("/dwh/dm_dp" "/dwh/misdm/dm_dp");

libname ztint26
    "/dwh/misdm/dm_dp_pl";


/* Set reporting dates */
%global zt_year zt_last zt_prev;

data _null_;
    rundate   = '01MAY2026'd;
    firstdate = intnx('month', rundate, -1, 'beginning');
    lastdate  = intnx('month', rundate, -1, 'end');
    prevdate  = lastdate - 1;

    call symputx('zt_year', year(lastdate), 'G');

    call symputx('zt_last',
        cats(put(month(lastdate), z2.),
             put(day(lastdate), z2.)), 'G');

    call symputx('zt_prev',
        cats(put(month(prevdate), z2.),
             put(day(prevdate), z2.)), 'G');

    put 'NOTE: === TEST REPORTING DATES ===';
    put rundate= date9.
        firstdate= date9.
        lastdate= date9.;
run;


/* =========================================================
   Report one row per ACCTNO / CDNO.

   Reproduce original filter:
       amount NOT IN (.,0)

   Include only deals where:
   - At least one source row survives on 29 April.
   - No source row survives on 30 April from either source.

   Aggregate indicators to handle duplicate source keys.
   ========================================================= */

proc sql;
    select
        ACCTNO format=20.
            label='Account Number',

        CDNO format=20.
            label='CD Number',

        sum(is_balance)
            as balance_source_rows format=comma12.
            label='Balance Source Rows',

        sum(is_interest)
            as interest_source_rows format=comma12.
            label='Interest Source Rows',

        sum(balance_prev_kept)
            as balance_kept_29apr format=comma12.
            label='Balance Kept 29APR',

        sum(interest_prev_kept)
            as interest_kept_29apr format=comma12.
            label='Interest Kept 29APR',

        sum(balance_last_missing)
            as balance_missing_30apr format=comma12.
            label='Balance Missing 30APR',

        sum(balance_last_zero)
            as balance_zero_30apr format=comma12.
            label='Balance Zero 30APR',

        sum(interest_last_missing)
            as interest_missing_30apr format=comma12.
            label='Interest Missing 30APR',

        sum(interest_last_zero)
            as interest_zero_30apr format=comma12.
            label='Interest Zero 30APR',

        sum(balance_last_kept)
            as balance_kept_30apr format=comma12.
            label='Balance Kept 30APR',

        sum(interest_last_kept)
            as interest_kept_30apr format=comma12.
            label='Interest Kept 30APR'

    from
    (
        /* Balance source */
        select
            ACCTNO,
            CDNO,

            1 as is_balance,
            0 as is_interest,

            (DLY_BAL_&zt_prev not in (.,0))
                as balance_prev_kept,

            0 as interest_prev_kept,

            (DLY_BAL_&zt_last = .)
                as balance_last_missing,

            (DLY_BAL_&zt_last = 0)
                as balance_last_zero,

            0 as interest_last_missing,
            0 as interest_last_zero,

            (DLY_BAL_&zt_last not in (.,0))
                as balance_last_kept,

            0 as interest_last_kept

        from ztbal26.BALBASE_FD_CD&zt_year

        union all

        /* Interest source — same column order */
        select
            ACCTNO,
            CDNO,

            0 as is_balance,
            1 as is_interest,

            0 as balance_prev_kept,

            (DLY_INTEXP_&zt_prev not in (.,0))
                as interest_prev_kept,

            0 as balance_last_missing,
            0 as balance_last_zero,

            (DLY_INTEXP_&zt_last = .)
                as interest_last_missing,

            (DLY_INTEXP_&zt_last = 0)
                as interest_last_zero,

            0 as balance_last_kept,

            (DLY_INTEXP_&zt_last not in (.,0))
                as interest_last_kept

        from ztint26.DAILY_FDCD_INTEXP_&zt_year

    ) as source_checks

    group by ACCTNO, CDNO

    having
        (
            calculated balance_kept_29apr
          + calculated interest_kept_29apr
        ) > 0

        and calculated balance_kept_30apr = 0
        and calculated interest_kept_30apr = 0

    order by ACCTNO, CDNO;
quit;


/* Disconnect test aliases — does not delete files */
libname ztbal26 clear;
libname ztint26 clear;
