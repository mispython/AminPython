*+---------------------------------------------------------------+
 |  PROGRAM  : LNCCD004                                          |
 |  DATE     : 01.01.98                                          |
 |  FUNCTION : LOANS IN ARREARS CLASSIFIED AS NPL FOR CCD PFB.   |
 |             (FOR 10 & 20 OF THE MONTH)                        |
 |  NOTE     : REMOVE THE BORSTAT 'I' FOR HOUSING LOAN AND       |
 |             FIXED LOAN, REFER TO EMAIL FROM NKW, SAM, CREDIT  |
 |             CONTROL, BRANCH ADMINSTRATION, PFB. DATED ON      |
 |             19TH OCT 2001.                                    |
 +---------------------------------------------------------------+
 |  MODIFIED (ESMR) : 2005-610, 2006-1048                        |
 +---------------------------------------------------------------+;

TITLE;

*+---------------------------------------------------------------+
 |  THIS PART IS FOR HP DIRECT, IE PRODUCT CODE 128 & 130 &      |
 |                                  380 & 381 & 700 & 705.       |
 +---------------------------------------------------------------+;
DATA LOAN1;
  FORMAT  TYPE  $14.;
  SET BNM.LOANTEMP;
  CENSUS9 = SUBSTR(PUT(CENSUS,8.2),7,1);
  IF BALANCE > 0 AND BORSTAT NE 'Z';
  IF ARREAR > 3 OR BORSTAT = 'R' OR BORSTAT = 'I'
     OR BORSTAT = 'F' OR CENSUS9 = '9' OR USER5= 'N' THEN DO;
     IF PRODUCT IN (380,381,700,705,720,725,15,20) AND
        (BORSTAT IN ('R','I','F')  OR (ARREAR > 3)
        OR USER5 = 'N') THEN DO;
        CAT  = 'A';
        TYPE = '(HPD-C)';
        OUTPUT;
     END;
     IF PRODUCT IN (380,381) AND
        (BORSTAT IN ('R','I','F')  OR (ARREAR > 3)
        OR USER5 = 'N') THEN DO;
        CAT  = 'B';
        TYPE = '(HP 380/381)';
        OUTPUT;
     END;
     IF PRODUCT IN (128,130,131,132) AND
        (BORSTAT IN ('R','I','F')  OR (ARREAR > 3)
        OR USER5 = 'N') THEN DO;
        CAT  = 'C';
        TYPE = '(AITAB)';
        OUTPUT;
     END;
     IF (PRODUCT IN &HPD OR PRODUCT IN (15,20)) AND
        (BORSTAT IN ('R','I','F')  OR (ARREAR > 3)
        OR USER5 = 'N') THEN DO;
        CAT  = 'D';
        TYPE = '(-HPD-)';
        OUTPUT;
     END;
  END;
RUN;

PROC SORT DATA=LOAN1; BY BRANCH;

DATA LOAN1;
  MERGE LOAN1(IN=PRESENT) BRHDATA;
  BY BRANCH;
  IF PRESENT=1 THEN OUTPUT LOAN1;
RUN;

