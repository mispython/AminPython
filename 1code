	CALL SYMPUT('AVGMTH',PUT(MONTH(MTHEND),Z2.));
	CALL SYMPUT('AVGYR',PUT(MTHEND,YEAR4.));
    CALL SYMPUT('PBBPLN',"974,448,449,450,568,570,572,972,973,971");
    CALL SYMPUT('PBBH_COUNT',"10"); *BASED ON PBBPLN;
    CALL SYMPUT('PIBBPLN'," ");
    CALL SYMPUT('PIBB_COUNT',"0");  *BASED ON PIBBPLN;
