options yearcutoff=1950 nocenter;

/* Input/output locations */
libname input "/host_pq/mis/input/OCM";
libname out   "/dwh/pbcs";

/* JNL_MONTHLY is a raw FB binary file */
filename jnlmth "/host_pq/mis/input/OCM/JNL_MONTHLY"
    recfm=f
    lrecl=224;

/* Default report date: previous month end */
%let report_date  = %sysfunc(intnx(month,%sysfunc(today()),-1,e));
%let report_month = %sysfunc(month(&report_date),z2.);
%let report_year2 = %sysfunc(year(&report_date),z2.);
%let report_year4 = %sysfunc(year(&report_date),z4.);

%put NOTE: Report date = %sysfunc(putn(&report_date,date9.));
%put NOTE: Full output = out.ATMTRNX&report_month.&report_year2;
%put NOTE: Cash output = out.ATM_CASH&report_year4.&report_month;


