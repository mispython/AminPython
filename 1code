"""Fast first-stage EIBMDPFF input check; does not run the report or modify inputs.

python check_eibmdpff.py --run-date 2026-09-04
Requires pandas and numpy. Reads three SAS7BDAT files once, in bounded chunks.
Compare CHECK_EIBMDPFF_INPUTS.csv to SAS counts and sums at the same stages.
This does NOT reproduce customer merging or prove the cause of report differences.
"""
import argparse
import csv
import math
import time
from datetime import date, timedelta
from pathlib import Path

import numpy as np
import pandas as pd

STFSA = {151, 181, 200, 201, 215}
STFCA = {*range(50, 66), 101, 103, 106, 151, 158, 164, 180, 181, 182}
FD_EXCLUSIONS = ((400,428), (448,469), (600,639), (720,740), (470,499), (548,573))


class SumCheck:
    def __init__(self):
        self.rows = 0
        self.missing = 0
        self.sequential = 0.0
        self.partials = []
        self.subcent = 0

    def add(self, values):
        values = np.asarray(values, dtype=np.float64)
        self.rows += len(values)
        self.missing += int(np.isnan(values).sum())
        values = values[~np.isnan(values)]
        if not np.isfinite(values).all():
            raise ValueError('Non-finite CURBAL encountered')
        if not len(values):
            return
        # Carry the preceding sum into cumsum to preserve sequential input order.
        self.sequential = float(np.cumsum(np.concatenate(([self.sequential], values)))[-1])
        self.partials.append(math.fsum(values))
        # Indicator only: tolerance avoids classifying ordinary binary cent noise.
        self.subcent += int((np.abs(values * 100 - np.rint(values * 100)) > 0.0001).sum())

    def result(self, dataset, stage, reporting_date):
        compensated = math.fsum(self.partials)
        return dict(
            REPTDATE=str(reporting_date), DATASET=dataset, STAGE=stage,
            ROWS=self.rows, MISSING_CURBAL=self.missing,
            SUBCENT_INDICATOR_ROWS=self.subcent,
            SEQUENTIAL_SUM=format(self.sequential, '.17g'),
            CHUNK_FSUM=format(compensated, '.17g'),
            FSUM_MINUS_SEQUENTIAL=format(compensated-self.sequential, '.17g'),
        )


def filtered(frame, dataset):
    required = {'ENTITY_CD','ACCTNO','CURBAL','BRANCH','OPENIND',
                'INTPLAN' if dataset == 'FD' else 'PRODUCT'}
    absent = required - set(frame.columns)
    if absent:
        raise ValueError(f'{dataset}: missing columns {sorted(absent)}')
    pbb = ~frame.ENTITY_CD.fillna('').str.rstrip().isin(['PIBB'])
    mask = pbb & (frame.BRANCH > 1) & (frame.BRANCH < 271)
    mask &= ~frame.OPENIND.fillna('').str.rstrip().isin(['B','C','P'])
    if dataset == 'SAVING':
        mask &= ~frame.PRODUCT.isin(STFSA)
    elif dataset == 'CURRENT':
        mask &= ~frame.PRODUCT.isin(STFCA)
    else:
        for low, high in FD_EXCLUSIONS:
            mask &= ~frame.INTPLAN.between(low, high)
    return pbb, mask


def resolve(path):
    if path.is_file():
        return path
    matches = [p for p in path.parent.iterdir() if p.is_file() and p.name.lower() == path.name.lower()]
    if len(matches) != 1:
        raise FileNotFoundError(f'Cannot uniquely resolve {path}')
    return matches[0]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run-date', type=date.fromisoformat, default=date.today())
    parser.add_argument('--report-date', type=date.fromisoformat)
    parser.add_argument('--deposit-dir', type=Path, default=Path('/sas/deposit/dwh/integration'))
    parser.add_argument('--output-dir', type=Path, default=Path('/stgsrcsys/host/holding'))
    parser.add_argument('--encoding', default='latin1')
    parser.add_argument('--chunk-size', type=int, default=200000)
    for dataset in ('saving','current','fd'):
        parser.add_argument('--'+dataset, type=Path)
    args = parser.parse_args()
    if args.chunk_size < 1:
        parser.error('--chunk-size must be positive')
    reporting_date = args.report_date or args.run_date.replace(day=1)-timedelta(days=1)
    print(f'REPTDATE: {reporting_date}; input check only; no CIS or report generation', flush=True)
    rows = []
    for dataset in ('SAVING','CURRENT','FD'):
        path = getattr(args,dataset.lower()) or args.deposit_dir/f'INTG_DP_ACCT_{dataset}_D{reporting_date:%d}.sas7bdat'
        path = resolve(path)
        before, after = SumCheck(), SumCheck()
        started = time.monotonic()
        print(f'Reading {path}', flush=True)
        reader = pd.read_sas(path, format='sas7bdat', encoding=args.encoding, chunksize=args.chunk_size)
        try:
            for i, frame in enumerate(reader, 1):
                frame.columns = frame.columns.str.upper()
                pbb, eligible = filtered(frame,dataset)
                before.add(frame.loc[pbb,'CURBAL'])
                after.add(frame.loc[eligible,'CURBAL'])
                if i % 5 == 0:
                    print(f'  {dataset}: {i} chunks scanned', flush=True)
        finally:
            reader.close()
        rows += [before.result(dataset,'PBB_BEFORE_FILTER',reporting_date),
                 after.result(dataset,'PBB_AFTER_FILTER_BEFORE_CIS',reporting_date)]
        print(f'  Finished in {time.monotonic()-started:.1f}s; eligible rows={after.rows:,}', flush=True)
    args.output_dir.mkdir(parents=True, exist_ok=True)
    target = args.output_dir/'CHECK_EIBMDPFF_INPUTS.csv'
    with target.open('w',newline='',encoding='utf-8') as handle:
        writer = csv.DictWriter(handle,fieldnames=list(rows[0]))
        writer.writeheader()
        writer.writerows(rows)
    print(f'Written: {target}')
    print('Compare counts and sums to SAS at identical pre-CIS stages. Floating-point differences here are indicators, not proof of the final RM0.66 cause.')


if __name__ == '__main__':
    main()
