%MACRO COLUMNA(TYPE); 
DATA BRKTYPE&TYPE;
  SET &TYPE.LIST ;
  BY ACCTNO D_BANK_ENTITY D_INDV_ORG_LTST D_STAFF_IND_LTST;
  IF FIRST.ACCTNO OR FIRST.D_BANK_ENTITY                           THEN CUST_ACCT = 1; 
  IF FIRST.ACCTNO OR FIRST.D_INDV_ORG_LTST                         THEN INDV_ACCT = 1;
  IF FIRST.ACCTNO OR FIRST.D_BANK_ENTITY OR FIRST.D_STAFF_IND_LTST THEN STF_ACCT = 1; 


  IF D_BANK_ENTITY = 'PBBH' THEN DO;
     PBBH&TYPE._ACCT = CUST_ACCT;
	 PBBH&TYPE._AMT  = M_BAL;
	 *OF WHICH STAFF;
	 IF UPCASE(D_STAFF_IND_LTST) = 'STAFF' THEN DO;
        STFPBBH&TYPE._ACCT = STF_ACCT;
        STFPBBH&TYPE._AMT  = M_BAL;
     END; 
	 IF UPCASE(D_INDV_ORG_LTST) = 'INDIVIDUAL' THEN DO;
	     PBBH&TYPE._INDVACCT = INDV_ACCT;
	     PBBH&TYPE._INDVAMT  = M_BAL;    
	 END;
	 ELSE DO;
     	 PBBH&TYPE._ORGACCT = INDV_ACCT;
	 	 PBBH&TYPE._ORGAMT  = M_BAL;	     
	 END;
  END;
  ELSE IF D_BANK_ENTITY = 'PIBB' THEN DO;
     PIBB&TYPE._ACCT = CUST_ACCT;
	 PIBB&TYPE._AMT  = M_BAL;
	 *OF WHICH STAFF;
	 IF UPCASE(D_STAFF_IND_LTST) = 'STAFF' THEN DO;
        STFPIBB&TYPE._ACCT = STF_ACCT;
        STFPIBB&TYPE._AMT  = M_BAL;
     END; 
	 IF UPCASE(D_INDV_ORG_LTST) = 'INDIVIDUAL' THEN DO;
	     PIBB&TYPE._INDVACCT = INDV_ACCT;
	     PIBB&TYPE._INDVAMT  = M_BAL;    
	 END;
	 ELSE DO;
     	 PIBB&TYPE._ORGACCT = INDV_ACCT;
	 	 PIBB&TYPE._ORGAMT  = M_BAL;	     
	 END;
  END;
RUN;
PROC SUMMARY DATA=BRKTYPE&TYPE NWAY;
    CLASS REPTDATE;
	VAR PBBH&TYPE._ACCT PBBH&TYPE._AMT STFPBBH&TYPE._ACCT STFPBBH&TYPE._AMT
        PIBB&TYPE._ACCT PIBB&TYPE._AMT STFPIBB&TYPE._ACCT STFPIBB&TYPE._AMT
        PBBH&TYPE._INDVACCT PBBH&TYPE._INDVAMT 
        PIBB&TYPE._INDVACCT PIBB&TYPE._INDVAMT 
        PBBH&TYPE._ORGACCT PBBH&TYPE._ORGAMT 
