def packed_decimal(raw: bytes, scale: int = 0) -> Decimal | None:
    if not raw:
        return None

    nibbles = [
        nibble
        for byte in raw
        for nibble in (byte >> 4, byte & 0x0F)
    ]
    sign_nibble = nibbles.pop()

    if sign_nibble in (0x0B, 0x0D):
        sign = -1
    elif sign_nibble in (0x0A, 0x0C, 0x0E, 0x0F):
        sign = 1
    else:
        return None

    if any(nibble > 9 for nibble in nibbles):
        return None

    value = Decimal("".join(map(str, nibbles))).scaleb(-scale)
    return value if sign > 0 else -value


def binary_integer(raw: bytes) -> int | None:
    if not raw:
        return None
    return int.from_bytes(raw, byteorder="big", signed=True)


def decoded(raw: bytes, encoding: str) -> str:
    return raw.decode(encoding, errors="replace").strip()


def numeric_text(raw: bytes, encoding: str) -> int | None:
    value = decoded(raw, encoding)
    return int(value) if value else None


def sas_transaction_date(value: Decimal | None) -> int | None:
    if value is None:
        return None

    digits = str(abs(int(value))).zfill(8)[-8:]

    try:
        parsed = datetime.strptime(digits, "%Y%m%d").date()
    except ValueError:
        return None

    return (parsed - date(1960, 1, 1)).days


def parse_record(record: bytes, encoding: str) -> dict[str, object]:
    if len(record) != DEFAULT_RECORD_LENGTH:
        raise ValueError(
            f"Record is {len(record)} bytes; expected "
            f"{DEFAULT_RECORD_LENGTH}"
        )

    trnxdt = packed_decimal(record[0:5])
    trnxtime = packed_decimal(record[5:9])
    branch = packed_decimal(record[11:14])
    trnxcode = binary_integer(record[18:20])
    compind = decoded(record[37:38], encoding)
    authind = decoded(record[38:39], encoding)

    return {
        "CARDNO": decoded(record[70:90], encoding),
        "BRANCH": int(branch) if branch is not None else None,
        "TERMNO": binary_integer(record[14:18]),
        "TRNXTIME": int(trnxtime) if trnxtime is not None else None,
        "TRNXCODE": trnxcode,
        "ATMTYPE": numeric_text(record[9:11], encoding),
        "TRNXAMT": float(
            packed_decimal(record[20:28], 2) or Decimal(0)
        ),
        "SUCCESS_TRAN_AMT": float(
            packed_decimal(record[28:36], 2) or Decimal(0)
        ),
        "DENIAL_CD": numeric_text(record[46:49], encoding),
        "CARDTYPE": decoded(record[54:56], encoding),
        "ACCTNO": numeric_text(record[90:106], encoding),
        "STATE_CD": decoded(record[166:168], encoding),
        "TRNXTYPE": TYPE_FORMAT.get(trnxcode, ""),
        "TRNXDATE": sas_transaction_date(trnxdt),
        "TRNXSTAT": (
            "S" if compind == "S" and authind == "A" else "R"
        ),
    }


def fixed_records(
    content: bytes,
    record_length: int,
    separator: bytes,
) -> list[bytes] | None:
    stride = record_length + len(separator)

    if not content or len(content) % stride:
        return None

    records = []

    for offset in range(0, len(content), stride):
        block = content[offset:offset + stride]

        if separator and block[record_length:] != separator:
            return None

        records.append(block[:record_length])

    return records


def read_records(path: Path, record_length: int) -> list[bytes]:
    if not path.is_file():
        raise FileNotFoundError(f"Missing input file: {path}")

    content = path.read_bytes()

    if not content:
        return []

    for separator in (b"\r\n", b"\n", b""):
        records = fixed_records(content, record_length, separator)

        if records is not None:
            return records

    raise ValueError(
        f"Input size {len(content):,} is incompatible with "
        f"RECFM=FB,LRECL={record_length}. Ensure the file was "
        "extracted in binary mode."
    )


def parse_date(value: str) -> date:
    try:
        return datetime.strptime(value, "%Y-%m-%d").date()
    except ValueError as error:
        raise argparse.ArgumentTypeError(
            "date must be YYYY-MM-DD"
        ) from error


def write_sas7bdat(
    output_dir: Path,
    tables: dict[str, pd.DataFrame],
) -> dict[str, Path]:
    try:
        import saspy
    except ImportError as error:
        raise RuntimeError(
            "saspy and a configured SAS runtime are required"
        ) from error

    output_dir.mkdir(parents=True, exist_ok=True)

    sas = saspy.SASsession()

    try:
        sas_path = str(output_dir.resolve()).replace("'", "''")
        result = sas.submit(f"libname OUT '{sas_path}';")

        if "ERROR:" in result.get("LOG", ""):
            raise RuntimeError(result["LOG"])

        for table, frame in tables.items():
            stage = f"_PY_{table}"
            sas.df2sd(frame, table=stage, libref="OUT")

            if table.startswith("ATMTRNX"):
                program = f"""
data OUT.{table};
    length CARDNO $20 BRANCH 8 TERMNO 8 TRNXTIME 8
           TRNXCODE 8 ATMTYPE 8 TRNXAMT 8
           SUCCESS_TRAN_AMT 8 DENIAL_CD 8 CARDTYPE $2
           ACCTNO 8 STATE_CD $2 TRNXTYPE $26
           TRNXDATE 8 TRNXSTAT $1;
    set OUT.{stage};
    format TERMNO Z4. TRNXTIME Z6.;
run;
"""
            else:
                program = f"""
data OUT.{table};
    length CARDNO $20 TRNXTIME 8 TRNXAMT 8
           TRNXTYPE $26 TRNXDATE 8;
    set OUT.{stage};
    format TRNXTIME Z6. TRNXDATE DDMMYY10.;
run;
"""

            result = sas.submit(program)

            if "ERROR:" in result.get("LOG", ""):
                raise RuntimeError(result["LOG"])

            result = sas.submit(
                "proc datasets library=OUT nolist;"
                f" delete {stage};"
                " quit;"
            )

            if "ERROR:" in result.get("LOG", ""):
                raise RuntimeError(result["LOG"])

    finally:
        sas.endsas()

    return {
        table: output_dir / f"{table}.sas7bdat"
        for table in tables
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)

    parser.add_argument(
        "--input",
        type=Path,
        default=DEFAULT_INPUT,
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=DEFAULT_OUTPUT_DIR,
    )
    parser.add_argument(
        "--report-date",
        type=parse_date,
        default=date.today().replace(day=1) - timedelta(days=1),
    )
    parser.add_argument(
        "--encoding",
        default="cp037",
    )
    parser.add_argument(
        "--record-length",
        type=int,
        default=DEFAULT_RECORD_LENGTH,
    )

    args = parser.parse_args()

    records = read_records(args.input, args.record_length)
    rows = []

    for record_number, record in enumerate(records, start=1):
        try:
            rows.append(parse_record(record, args.encoding))
        except ValueError as error:
            raise ValueError(
                f"Failed to parse record {record_number:,}: {error}"
            ) from error

    transactions = pd.DataFrame(rows, columns=FULL_COLUMNS)

    cash = transactions.loc[
        (transactions["TRNXSTAT"] == "S")
        & transactions["CARDTYPE"].isin(["00", "02", "03", "04"])
        & transactions["TRNXCODE"].isin([1, 2, 129]),
        ["CARDNO", "TRNXTIME", "TRNXAMT", "TRNXTYPE", "TRNXDATE"],
    ].copy()

    full_table = f"ATMTRNX{args.report_date:%m%y}"
    cash_table = f"ATM_CASH{args.report_date:%Y%m}"

    outputs = write_sas7bdat(
        args.output_dir,
        {
            full_table: transactions,
            cash_table: cash,
        },
    )

    print(f"Input      : {args.input}")
    print(f"Rows input : {len(transactions):,}")
    print(f"Cash rows  : {len(cash):,}")
    print(f"ATMTRNX    : {outputs[full_table]}")
    print(f"ATM_CASH   : {outputs[cash_table]}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
