	CALL SYMPUT('REPTYEAR', PUT(REPTDATE,YEAR4.));
    CALL SYMPUT('REPTYR', PUT(REPTDATE,YEAR2.));
	CALL SYMPUT('REPTMON', PUT(MONTH(REPTDATE),Z2.));
	CALL SYMPUT('REPTDAY', PUT(DAY(REPTDATE),Z2.));
    CALL SYMPUT('RMONNM',COMPRESS(UPCASE(PUT(REPTDATE,MONNAME.))));
    CALL SYMPUT('REPTDT',REPTDATE);
	CALL SYMPUT('CAMPAIGN_STDT',CAM_START); 
	CALL SYMPUT('CAM_YR',PUT(CAM_START,YEAR4.));
	CALL SYMPUT('CAM_MTH',PUT(MONTH(CAM_START),Z2.));
