	CALL SYMPUT('PBBH_NAME','PB eFD');
	CALL SYMPUT('PIBB_NAME',' ');
/*    CALL SYMPUT('VALPROD','311,312');*/
    CALL SYMPUT('FOLDERNME','PBeFDFPX0126'); 

	   DD     = DAY(REPTDATE);

  IF DD<9  THEN DO; NOWK=1; WEEKDATE=MDY(MONTH(REPTDATE),1,YEAR(REPTDATE))-1; END;
   ELSE IF DD<16 THEN DO; NOWK=2; WEEKDATE=MDY(MONTH(REPTDATE),8,YEAR(REPTDATE)); END;
   ELSE IF DD<23 THEN DO; NOWK=3; WEEKDATE=MDY(MONTH(REPTDATE),15,YEAR(REPTDATE)); END;
   ELSE DO;               NOWK=4; WEEKDATE=MDY(MONTH(REPTDATE),22,YEAR(REPTDATE)); END;
  CALL SYMPUTX('NOWK',PUT(NOWK,$1.));
    CALL SYMPUTX('DD',DD);



RUN;
