/* Read the IBM mainframe binary records */
data out.ATMTRNX&report_month.&report_year2;
    length
        CARDNO          $20
        BRANCH            8
        TERMNO            8
        TRNXTIME          8
        TRNXCODE          8
        ATMTYPE           8
        TRNXAMT           8
        SUCCESS_TRAN_AMT  8
        DENIAL_CD         8
        CARDTYPE         $2
        ACCTNO            8
        STATE_CD         $2
        TRNXTYPE         $26
        TRNXDATE          8
        TRNXSTAT         $1
        COMPIND          $1
        AUTHIND          $1
        _ATMTYPE         $2
        _DENIAL_CD       $3
        _ACCTNO         $16
    ;

    infile jnlmth truncover;

    /*
       S370 informats read IBM mainframe binary data correctly
       when SAS is running on Linux.
    */
    input
        @001 TRNXDT           s370fpd5.
        @006 TRNXTIME         s370fpd4.
        @010 _ATMTYPE         $ebcdic2.
        @012 BRANCH           s370fpd3.
        @015 TERMNO           s370fib4.
        @019 TRNXCODE         s370fib2.
        @021 TRNXAMT          s370fpd8.2
        @029 SUCCESS_TRAN_AMT s370fpd8.2
        @038 COMPIND          $ebcdic1.
        @039 AUTHIND          $ebcdic1.
        @047 _DENIAL_CD       $ebcdic3.
        @055 CARDTYPE         $ebcdic2.
        @071 CARDNO           $ebcdic20.
        @091 _ACCTNO          $ebcdic16.
        @167 STATE_CD         $ebcdic2.
    ;

    ATMTYPE = input(strip(_ATMTYPE),best32.);
    DENIAL_CD = input(strip(_DENIAL_CD),best32.);
    ACCTNO = input(strip(_ACCTNO),best32.);

    TRNXTYPE = put(TRNXCODE,type.);

    if not missing(TRNXDT) then
        TRNXDATE = input(put(TRNXDT,z8.),yymmdd8.);

    if COMPIND = "S" and AUTHIND = "A" then
        TRNXSTAT = "S";
    else
        TRNXSTAT = "R";

    format TERMNO z4.
           TRNXTIME z6.;

    drop TRNXDT COMPIND AUTHIND
         _ATMTYPE _DENIAL_CD _ACCTNO;
run;


/* Create ATM cash output */
data out.ATM_CASH&report_year4.&report_month;
    set out.ATMTRNX&report_month.&report_year2;

    where TRNXSTAT = "S"
      and CARDTYPE in ("00","02","03","04")
      and TRNXCODE in (1,2,129);

    keep CARDNO TRNXTIME TRNXAMT TRNXTYPE TRNXDATE;

    format TRNXTIME z6.
           TRNXDATE ddmmyy10.;
run;


/* Display output row counts */
proc sql;
    select count(*) as ATMTRNX_ROWS format=comma20.
    from out.ATMTRNX&report_month.&report_year2;

    select count(*) as ATM_CASH_ROWS format=comma20.
    from out.ATM_CASH&report_year4.&report_month;
quit;


/* Validate output structure */
proc contents
    data=out.ATMTRNX&report_month.&report_year2
    varnum;
run;

proc contents
    data=out.ATM_CASH&report_year4.&report_month
    varnum;
run;


/* Release files and libraries */
filename jnlmth clear;
libname input clear;
libname out clear;
